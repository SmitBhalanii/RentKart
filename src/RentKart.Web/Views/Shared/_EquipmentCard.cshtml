@model RentKart.Web.Models.Catalog.EquipmentListItemViewModel

<article class="rk-equipment-card" aria-label="@Model.CleanTitle">
    <!-- Equipment Image Container -->
    <div class="rk-equipment-card-media">
        <a asp-controller="Catalog" asp-action="Details" asp-route-id="@Model.Id" style="display: block; width: 100%; height: 100%; text-decoration: none;">
            @if (!string.IsNullOrEmpty(Model.PrimaryImageUrl))
            {
                <img src="@Model.PrimaryImageUrl" 
                     alt="@Model.CleanTitle" 
                     loading="lazy" 
                     style="width: 100%; height: 100%; object-fit: cover;" 
                     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                <div style="display: none; align-items: center; justify-content: center; width: 100%; height: 100%; background: #F8FAFC; color: #94A3B8;">
                    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                        <circle cx="8.5" cy="8.5" r="1.5"></circle>
                        <polyline points="21 15 16 10 5 21"></polyline>
                    </svg>
                </div>
            }
            else
            {
                <div style="display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; background: #F8FAFC; color: #94A3B8;">
                    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                        <circle cx="8.5" cy="8.5" r="1.5"></circle>
                        <polyline points="21 15 16 10 5 21"></polyline>
                    </svg>
                </div>
            }
        </a>

        <!-- Badges Overlay -->
        <div class="rk-equipment-card-badges">
            <span class="rk-badge-category-pill">@Model.CategoryName</span>
        </div>

        <!-- Wishlist Toggle -->
        <div style="position: absolute; top: 0.65rem; right: 0.65rem; z-index: 2;">
            <form asp-controller="Wishlist" asp-action="Toggle" method="post" style="margin: 0;">
                <input type="hidden" name="equipmentId" value="@Model.Id" />
                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                <button type="submit" 
                        class="rk-btn rk-btn-sm" 
                        style="padding: 0.35rem; border-radius: var(--rk-radius-full); background: rgba(255, 255, 255, 0.92); border: 1px solid rgba(0,0,0,0.06); box-shadow: 0 2px 6px rgba(0,0,0,0.15); color: @(Model.IsInWishlist ? "#EF4444" : "#64748B");" 
                        title="@(Model.IsInWishlist ? "Remove from Wishlist" : "Save to Wishlist")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="@(Model.IsInWishlist ? "currentColor" : "none")" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                    </svg>
                </button>
            </form>
        </div>
    </div>

    <!-- Equipment Content -->
    <div class="rk-equipment-card-content">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.35rem;">
            <div class="rk-equipment-card-category">@Model.CategoryName</div>
            <span class="rk-badge rk-badge-neutral" style="font-size: 0.6875rem; padding: 0.2rem 0.5rem;">
                <span class="rk-badge-dot" style="background-color: #10B981;"></span>@Model.Condition
            </span>
        </div>

        <h3 class="rk-equipment-card-title">
            <a asp-controller="Catalog" asp-action="Details" asp-route-id="@Model.Id" title="@Model.CleanTitle">
                @Model.CleanTitle
            </a>
        </h3>

        <!-- Actual Business Store & Location -->
        <div class="rk-equipment-card-store">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            </svg>
            <a asp-controller="Store" asp-action="Details" asp-route-id="@Model.BusinessId" title="@Model.ShopName in @Model.City, @Model.State">
                @Model.ShopName &bull; @Model.City, @Model.State
            </a>
        </div>

        <!-- Pricing & Action -->
        <div class="rk-equipment-card-pricing">
            <div>
                <div class="rk-rate-amount">
                    @Model.DailyRentalRate.ToInr() <span class="rk-rate-unit">/ day</span>
                </div>
                <div class="rk-deposit-label">
                    @Model.SecurityDeposit.ToInr() security deposit
                </div>
            </div>
            <a asp-controller="Catalog" asp-action="Details" asp-route-id="@Model.Id" class="rk-btn rk-btn-teal rk-btn-sm" aria-label="View details for @Model.CleanTitle">
                View Details
            </a>
        </div>
    </div>
</article>

