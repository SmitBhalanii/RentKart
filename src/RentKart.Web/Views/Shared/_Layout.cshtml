<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="RentKart is a local, multi-vendor equipment and product rental marketplace. Rent cameras, tools, electronics, camping gear, and more from nearby businesses." />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} - RentKart" : "RentKart — Rent Anything You Need")</title>

    <!-- Google Fonts Preconnect & Inter / Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Master Design System Stylesheet -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Accessible Keyboard Navigation Skip Link -->
    <a href="#mainContent" class="rk-skip-link">Skip to main content</a>

    <!-- Top Navigation Header -->
    <partial name="_Navbar" />

    <!-- Main Content Area: Flex-grows to push footer naturally to bottom -->
    <main id="mainContent" class="rk-main" role="main">
        <div class="rk-container" style="padding-top: var(--rk-space-4);">
            <partial name="_AlertMessages" />
        </div>
        @RenderBody()
    </main>

    <!-- Master Footer -->
    <partial name="_Footer" />

    <!-- Core Interactive Scripts -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
