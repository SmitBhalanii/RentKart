@*
    RentKart Shared Alert & Notification Partial
    Renders TempData notification banners with accessible semantic markup.
*@

@if (TempData["SuccessMessage"] != null)
{
    <div class="rk-alert rk-alert-success" role="alert">
        <svg class="rk-alert-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
        </svg>
        <div class="rk-alert-content">
            <strong>Success:</strong> @TempData["SuccessMessage"]
        </div>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="rk-alert rk-alert-danger" role="alert">
        <svg class="rk-alert-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <div class="rk-alert-content">
            <strong>Error:</strong> @TempData["ErrorMessage"]
        </div>
    </div>
}

@if (TempData["WarningMessage"] != null)
{
    <div class="rk-alert rk-alert-warning" role="alert">
        <svg class="rk-alert-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path>
            <line x1="12" y1="9" x2="12" y2="13"></line>
            <line x1="12" y1="17" x2="12.01" y2="17"></line>
        </svg>
        <div class="rk-alert-content">
            <strong>Notice:</strong> @TempData["WarningMessage"]
        </div>
    </div>
}

@if (TempData["InfoMessage"] != null)
{
    <div class="rk-alert rk-alert-info" role="alert">
        <svg class="rk-alert-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="16" x2="12" y2="12"></line>
            <line x1="12" y1="8" x2="12.01" y2="8"></line>
        </svg>
        <div class="rk-alert-content">
            <strong>Info:</strong> @TempData["InfoMessage"]
        </div>
    </div>
}
