@using Microsoft.AspNetCore.Identity
@using RentKart.Core.Entities
@using RentKart.Core.Interfaces
@using RentKart.Infrastructure.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject INotificationService NotificationService

@{
    int unreadNotificationCount = 0;
    if (SignInManager.IsSignedIn(User))
    {
        var currentUserId = UserManager.GetUserId(User);
        if (!string.IsNullOrEmpty(currentUserId))
        {
            unreadNotificationCount = await NotificationService.GetUnreadCountAsync(currentUserId);
        }
    }
}

@*
    RentKart Global Top Navigation
    Brand: RentKart | Tagline: Rent Anything You Need.
*@

<header class="rk-header" id="mainHeader">
    <div class="rk-container">
        <nav class="rk-navbar" aria-label="Main Navigation">
            <!-- Brand -->
            <a class="rk-brand" asp-area="" asp-controller="Home" asp-action="Index" aria-label="RentKart Home">
                <div class="rk-brand-logo" aria-hidden="true">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                        <line x1="3" y1="6" x2="21" y2="6"></line>
                        <path d="M16 10a4 4 0 0 1-8 0"></path>
                    </svg>
                </div>
                <div class="rk-brand-text">
                    <span class="rk-brand-title">Rent<span>Kart</span></span>
                    <span class="rk-brand-tagline">Rent Anything You Need</span>
                </div>
            </a>

            <!-- Header Quick Search Shell -->
            <div class="rk-nav-search" role="search">
                <form method="get" asp-controller="Catalog" asp-action="Index" class="rk-input-group">
                    <span class="rk-input-addon-left" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                    </span>
                    <input type="text" 
                           name="Search"
                           class="rk-form-control has-addon-left" 
                           placeholder="Search cameras, tools, projectors..." 
                           aria-label="Search equipment catalog" />
                </form>
            </div>

            <!-- Desktop Nav Links -->
            <ul class="rk-nav-links">
                <li>
                    <a class="rk-nav-link" asp-controller="Catalog" asp-action="Index">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                            <polyline points="9 22 9 12 15 12 15 22"></polyline>
                        </svg>
                        Browse Equipment
                    </a>
                </li>
                @if (User.IsInRole(IdentityDataSeeder.RoleAdmin))
                {
                    <li>
                        <a class="rk-nav-link" asp-controller="Admin" asp-action="Dashboard">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="12" cy="12" r="3"></circle>
                                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                            </svg>
                            Admin Portal
                        </a>
                    </li>
                }
                else if (User.IsInRole(IdentityDataSeeder.RoleBusiness))
                {
                    <li>
                        <a class="rk-nav-link" asp-controller="Business" asp-action="Dashboard">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                                <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                            </svg>
                            Store Dashboard
                        </a>
                    </li>
                    <li>
                        <a class="rk-nav-link" asp-controller="Business" asp-action="Equipment">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="m7.5 4.27 9 5.15"></path>
                                <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"></path>
                                <path d="m3.3 7 8.7 5 8.7-5"></path>
                                <path d="M12 22V12"></path>
                            </svg>
                            My Equipment
                        </a>
                    </li>
                    <li>
                        <a class="rk-nav-link" asp-controller="Business" asp-action="Bookings">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                <line x1="16" y1="2" x2="16" y2="6"></line>
                                <line x1="8" y1="2" x2="8" y2="6"></line>
                                <line x1="3" y1="10" x2="21" y2="10"></line>
                            </svg>
                            Reservations
                        </a>
                    </li>
                    <li>
                        <a class="rk-nav-link" asp-controller="Documents" asp-action="Index">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                <polyline points="14 2 14 8 20 8"></polyline>
                                <line x1="16" y1="13" x2="8" y2="13"></line>
                                <line x1="16" y1="17" x2="8" y2="17"></line>
                                <polyline points="10 9 9 9 8 9"></polyline>
                            </svg>
                            Documents
                        </a>
                    </li>
                }
                else if (User.IsInRole(IdentityDataSeeder.RoleCustomer))
                {
                    <li>
                        <a class="rk-nav-link" asp-controller="Booking" asp-action="MyBookings">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                <line x1="16" y1="2" x2="16" y2="6"></line>
                                <line x1="8" y1="2" x2="8" y2="6"></line>
                                <line x1="3" y1="10" x2="21" y2="10"></line>
                            </svg>
                            My Bookings
                        </a>
                    </li>
                    <li>
                        <a class="rk-nav-link" asp-controller="Documents" asp-action="Index">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                <polyline points="14 2 14 8 20 8"></polyline>
                                <line x1="16" y1="13" x2="8" y2="13"></line>
                                <line x1="16" y1="17" x2="8" y2="17"></line>
                                <polyline points="10 9 9 9 8 9"></polyline>
                            </svg>
                            Documents
                        </a>
                    </li>
                    <li>
                        <a class="rk-nav-link" asp-controller="Customer" asp-action="Dashboard">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                <circle cx="12" cy="7" r="4"></circle>
                            </svg>
                            My Account
                        </a>
                    </li>
                    <li>
                        <a class="rk-nav-link" asp-controller="Wishlist" asp-action="Index">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                            </svg>
                            Wishlist
                        </a>
                    </li>
                }
                else
                {
                    <li>
                        <a class="rk-nav-link" asp-controller="Home" asp-action="Index" fragment="how-it-works">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="12" cy="12" r="10"></circle>
                                <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                                <line x1="12" y1="17" x2="12.01" y2="17"></line>
                            </svg>
                            How It Works
                        </a>
                    </li>
                    <li>
                        <a class="rk-nav-link" asp-controller="Account" asp-action="RegisterBusiness">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                                <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                            </svg>
                            For Businesses
                        </a>
                    </li>
                }
            </ul>

            <!-- Header Action Buttons -->
            <div class="rk-nav-actions">
                <a class="rk-btn rk-btn-outline rk-btn-sm" asp-controller="Cart" asp-action="Index" style="display: inline-flex; align-items: center; gap: 0.35rem;" title="View rental cart">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="8" cy="21" r="1"></circle><circle cx="19" cy="21" r="1"></circle><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"></path></svg>
                    Cart
                </a>
                @if (SignInManager.IsSignedIn(User))
                {
                    <div style="display: flex; align-items: center; gap: var(--rk-space-2);">
                        <a class="rk-btn rk-btn-outline rk-btn-sm" asp-controller="Notifications" asp-action="Index" style="position: relative; display: inline-flex; align-items: center; justify-content: center; padding: 0.35rem 0.65rem;" title="Notifications">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                                <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                            </svg>
                            @if (unreadNotificationCount > 0)
                            {
                                <span class="rk-badge rk-badge-danger" style="position: absolute; top: -5px; right: -5px; font-size: 0.65rem; padding: 0.15rem 0.35rem; line-height: 1; border-radius: 9999px;">
                                    @(unreadNotificationCount > 99 ? "99+" : unreadNotificationCount.ToString())
                                </span>
                            }
                        </a>
                        <form asp-controller="Account" asp-action="Logout" method="post" style="margin: 0; display: inline;">
                            <button type="submit" class="rk-btn rk-btn-outline rk-btn-sm" title="Sign out of your account">
                                Sign Out
                            </button>
                        </form>
                    </div>
                }
                else
                {
                    <a class="rk-btn rk-btn-outline rk-btn-sm" asp-controller="Account" asp-action="Login">
                        Sign In
                    </a>
                    <a class="rk-btn rk-btn-teal rk-btn-sm" asp-controller="Account" asp-action="Register">
                        Register
                    </a>
                }

                <!-- Mobile Menu Button -->
                <button type="button" 
                        class="rk-nav-toggle" 
                        id="mobileMenuToggle" 
                        aria-expanded="false" 
                        aria-controls="mobileMenu" 
                        aria-label="Toggle navigation menu">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="3" y1="12" x2="21" y2="12"></line>
                        <line x1="3" y1="6" x2="21" y2="6"></line>
                        <line x1="3" y1="18" x2="21" y2="18"></line>
                    </svg>
                </button>
            </div>
        </nav>
    </div>

    <!-- Mobile Drawer Menu -->
    <div class="rk-mobile-menu" id="mobileMenu" aria-hidden="true">
        <a class="rk-nav-link" asp-area="" asp-controller="Home" asp-action="Index">Browse Equipment</a>
        @if (SignInManager.IsSignedIn(User))
        {
            @if (User.IsInRole(IdentityDataSeeder.RoleAdmin))
            {
                <a class="rk-nav-link" asp-controller="Admin" asp-action="Dashboard">Admin Portal</a>
                <a class="rk-nav-link" asp-controller="Admin" asp-action="Businesses">Manage Businesses</a>
            }
            else if (User.IsInRole(IdentityDataSeeder.RoleBusiness))
            {
                <a class="rk-nav-link" asp-controller="Business" asp-action="Dashboard">Store Dashboard</a>
                <a class="rk-nav-link" asp-controller="Business" asp-action="Profile">Store Profile</a>
            }
            else
            {
                <a class="rk-nav-link" asp-controller="Customer" asp-action="Dashboard">My Account</a>
                <a class="rk-nav-link" asp-controller="Customer" asp-action="Profile">Edit Profile</a>
            }
            <a class="rk-nav-link" asp-controller="Notifications" asp-action="Index">Notifications @(unreadNotificationCount > 0 ? $"({unreadNotificationCount})" : "")</a>
            <a class="rk-nav-link" asp-controller="Documents" asp-action="Index">Rental Documents</a>
            <div style="padding: 0.5rem 1rem;">
                <form asp-controller="Account" asp-action="Logout" method="post" style="margin: 0;">
                    <button type="submit" class="rk-btn rk-btn-outline" style="width: 100%; justify-content: center;">Sign Out</button>
                </form>
            </div>
        }
        else
        {
            <a class="rk-nav-link" asp-controller="Account" asp-action="RegisterBusiness">For Businesses</a>
            <a class="rk-nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
            <div style="display: flex; gap: var(--rk-space-2); margin-top: var(--rk-space-3); padding: 0 1rem;">
                <a class="rk-btn rk-btn-outline" style="flex: 1; text-align: center;" asp-controller="Account" asp-action="Login">Sign In</a>
                <a class="rk-btn rk-btn-teal" style="flex: 1; text-align: center;" asp-controller="Account" asp-action="Register">Register</a>
            </div>
        }
    </div>
</header>
