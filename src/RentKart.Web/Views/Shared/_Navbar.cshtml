@*
    RentKart Global Top Navigation
    Brand: RentKart | Tagline: Rent Anything You Need.
*@

<header class="rk-header" id="mainHeader">
    <div class="rk-container">
        <nav class="rk-navbar" aria-label="Main Navigation">
            <!-- Brand -->
            <a class="rk-brand" asp-area="" asp-controller="Home" asp-action="Index" aria-label="RentKart Home">
                <div class="rk-brand-logo" aria-hidden="true">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                        <line x1="3" y1="6" x2="21" y2="6"></line>
                        <path d="M16 10a4 4 0 0 1-8 0"></path>
                    </svg>
                </div>
                <div class="rk-brand-text">
                    <span class="rk-brand-title">Rent<span>Kart</span></span>
                    <span class="rk-brand-tagline">Rent Anything You Need</span>
                </div>
            </a>

            <!-- Header Quick Search Shell (Placeholder for Phase 6) -->
            <div class="rk-nav-search" role="search">
                <form method="get" action="#" onsubmit="event.preventDefault();" class="rk-input-group">
                    <span class="rk-input-addon-left" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                    </span>
                    <input type="text" 
                           class="rk-form-control has-addon-left" 
                           placeholder="Search cameras, tools, projectors..." 
                           aria-label="Search equipment catalog" />
                </form>
            </div>

            <!-- Desktop Nav Links -->
            <ul class="rk-nav-links">
                <li>
                    <a class="rk-nav-link active" asp-area="" asp-controller="Home" asp-action="Index">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                            <polyline points="9 22 9 12 15 12 15 22"></polyline>
                        </svg>
                        Browse Equipment
                    </a>
                </li>
                <li>
                    <a class="rk-nav-link" href="#how-it-works">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="10"></circle>
                            <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                            <line x1="12" y1="17" x2="12.01" y2="17"></line>
                        </svg>
                        How It Works
                    </a>
                </li>
                <li>
                    <a class="rk-nav-link" href="#businesses">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                            <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                        </svg>
                        For Businesses
                    </a>
                </li>
            </ul>

            <!-- Header Action Buttons -->
            <div class="rk-nav-actions">
                <a class="rk-btn rk-btn-outline rk-btn-sm" href="#component-preview" title="Sign In preview (implemented in Phase 4)">
                    Sign In
                </a>
                <a class="rk-btn rk-btn-teal rk-btn-sm" href="#businesses" title="List Your Business preview (implemented in Phase 4)">
                    List Business
                </a>
                <!-- Mobile Menu Button -->
                <button type="button" 
                        class="rk-nav-toggle" 
                        id="mobileMenuToggle" 
                        aria-expanded="false" 
                        aria-controls="mobileMenu" 
                        aria-label="Toggle navigation menu">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="3" y1="12" x2="21" y2="12"></line>
                        <line x1="3" y1="6" x2="21" y2="6"></line>
                        <line x1="3" y1="18" x2="21" y2="18"></line>
                    </svg>
                </button>
            </div>
        </nav>
    </div>

    <!-- Mobile Drawer Menu -->
    <div class="rk-mobile-menu" id="mobileMenu" aria-hidden="true">
        <a class="rk-nav-link" asp-area="" asp-controller="Home" asp-action="Index">Browse Equipment</a>
        <a class="rk-nav-link" href="#how-it-works">How It Works</a>
        <a class="rk-nav-link" href="#businesses">For Businesses</a>
        <a class="rk-nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
        <div style="display: flex; gap: var(--rk-space-2); margin-top: var(--rk-space-3); padding: 0 1rem;">
            <a class="rk-btn rk-btn-outline" style="flex: 1;" href="#component-preview">Sign In</a>
            <a class="rk-btn rk-btn-teal" style="flex: 1;" href="#businesses">Register</a>
        </div>
    </div>
</header>
