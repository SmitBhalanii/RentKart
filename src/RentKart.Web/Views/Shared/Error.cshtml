@model ErrorViewModel
@{
    ViewData["Title"] = "System Notification";
}

<div class="rk-container" style="padding-top: var(--rk-space-12); padding-bottom: var(--rk-space-16);">
    <div style="max-width: 600px; margin: 0 auto;">
        <div class="rk-card" style="padding: var(--rk-space-8); text-align: center;">
            <div style="width: 56px; height: 56px; border-radius: 50%; background-color: var(--rk-color-danger-bg); color: var(--rk-color-danger-text); display: inline-flex; align-items: center; justify-content: center; margin-bottom: var(--rk-space-4);">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
            </div>

            <h1 style="font-size: var(--rk-font-size-2xl); margin-bottom: var(--rk-space-2);">An Error Occurred</h1>
            <p style="color: var(--rk-text-secondary); margin-bottom: var(--rk-space-6);">
                We encountered an issue while processing your request. Please return to the catalog or try again in a moment.
            </p>

            @if (Model.ShowRequestId)
            {
                <div style="background-color: var(--rk-bg-muted); padding: var(--rk-space-3); border-radius: var(--rk-radius-md); font-size: var(--rk-font-size-xs); color: var(--rk-text-muted); margin-bottom: var(--rk-space-6); word-break: break-all;">
                    <strong>Request Identifier:</strong> <code>@Model.RequestId</code>
                </div>
            }

            <div style="display: flex; gap: var(--rk-space-3); justify-content: center;">
                <a asp-controller="Home" asp-action="Index" class="rk-btn rk-btn-primary">Return to Homepage</a>
                <a href="javascript:history.back()" class="rk-btn rk-btn-outline">Go Back</a>
            </div>
        </div>
    </div>
</div>
