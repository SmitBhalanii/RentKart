@using RentKart.Core.Enums
@model RentKart.Web.Models.Business.BusinessDashboardViewModel
@{
    ViewData["Title"] = "Business Dashboard";
}

<div class="rk-section" style="padding-top: var(--rk-space-6); padding-bottom: var(--rk-space-10);">
    <div class="rk-container">
        <!-- Store Header Banner -->
        <div class="rk-store-banner">
            <div class="rk-store-banner-inner">
                <div class="rk-store-banner-info">
                    <div class="rk-store-banner-icon">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                            <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                        </svg>
                    </div>
                    <div>
                        <div class="rk-store-banner-title-row">
                            <h1 class="rk-store-banner-title">@Model.ShopName</h1>
                            @switch (Model.Status)
                            {
                                case BusinessStatus.Approved:
                                    <span class="rk-badge rk-badge-success">Verified Store</span>
                                    break;
                                case BusinessStatus.PendingApproval:
                                    <span class="rk-badge rk-badge-warning">Verification Pending</span>
                                    break;
                                case BusinessStatus.Suspended:
                                    <span class="rk-badge rk-badge-error">Suspended</span>
                                    break;
                                case BusinessStatus.Rejected:
                                    <span class="rk-badge rk-badge-error">Rejected</span>
                                    break;
                            }
                        </div>
                        <p class="rk-store-banner-subtitle">
                            Owner: <strong>@Model.OwnerName</strong> &bull; @Model.Email &bull; Store ID #@Model.BusinessId
                        </p>
                    </div>
                </div>

                <div class="rk-store-banner-actions">
                    <a asp-action="Profile" class="rk-store-banner-btn-secondary">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                        </svg>
                        Edit Store Details
                    </a>
                    @if (Model.CanPublishListings)
                    {
                        <a asp-action="CreateEquipment" class="rk-store-banner-btn-primary">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="12" y1="5" x2="12" y2="19"></line>
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                            </svg>
                            + List Equipment
                        </a>
                    }
                    else
                    {
                        <button class="rk-store-banner-btn-primary" disabled title="Approval required before listing equipment">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                            </svg>
                            + List Equipment (Locked)
                        </button>
                    }
                </div>
            </div>
        </div>

        <!-- Status Context Alert -->
        @if (Model.Status == BusinessStatus.PendingApproval)
        {
            <div class="rk-alert rk-alert-warning" role="alert" style="margin-bottom: var(--rk-space-6); display: flex; gap: var(--rk-space-3); align-items: flex-start;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0; margin-top: 2px;">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                <div>
                    <strong style="font-size: var(--rk-font-size-sm); display: block; margin-bottom: 2px;">Verification in Progress</strong>
                    <div style="font-size: var(--rk-font-size-xs); line-height: 1.5;">
                        Your business profile is queued for review by the platform administration team. While your account is pending approval, you cannot publish equipment listings or accept customer reservations. You will be notified as soon as verification completes.
                    </div>
                </div>
            </div>
        }
        else if (Model.Status == BusinessStatus.Suspended)
        {
            <div class="rk-alert rk-alert-error" role="alert" style="margin-bottom: var(--rk-space-6); display: flex; gap: var(--rk-space-3); align-items: flex-start;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0; margin-top: 2px;">
                    <polygon points="7.86 2 16.14 2 22 7.86 22 16.14 16.14 22 7.86 22 2 16.14 2 7.86 7.86 2"></polygon>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                <div>
                    <strong style="font-size: var(--rk-font-size-sm); display: block; margin-bottom: 2px;">Account Suspended</strong>
                    <div style="font-size: var(--rk-font-size-xs); line-height: 1.5;">
                        This store account has been suspended by administration. Your equipment listings have been taken offline and customer handovers are restricted. Please contact RentKart Support for compliance resolution.
                    </div>
                </div>
            </div>
        }
        else if (Model.Status == BusinessStatus.Rejected)
        {
            <div class="rk-alert rk-alert-error" role="alert" style="margin-bottom: var(--rk-space-6); display: flex; gap: var(--rk-space-3); align-items: flex-start;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0; margin-top: 2px;">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="15" y1="9" x2="9" y2="15"></line>
                    <line x1="9" y1="9" x2="15" y2="15"></line>
                </svg>
                <div>
                    <strong style="font-size: var(--rk-font-size-sm); display: block; margin-bottom: 2px;">Application Rejected</strong>
                    <div style="font-size: var(--rk-font-size-xs); line-height: 1.5;">
                        Your business registration was reviewed and rejected by platform administration. Equipment listing creation and customer orders are disabled. If you have questions or updated verification documentation, please contact RentKart Support.
                    </div>
                </div>
            </div>
        }

        <!-- Operation KPI Metrics -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: var(--rk-space-4); margin-bottom: var(--rk-space-6);">
            <div class="rk-card rk-card-elevated" style="padding: var(--rk-space-4); border-left: 4px solid var(--rk-navy-900);">
                <div style="font-size: var(--rk-font-size-xs); color: var(--rk-text-muted); text-transform: uppercase; font-weight: 600;">Active Listings</div>
                <div style="font-size: var(--rk-font-size-2xl); font-weight: 800; color: var(--rk-navy-900); margin-top: 4px;">
                    @Model.ActiveListings <span style="font-size: var(--rk-font-size-sm); font-weight: normal; color: var(--rk-text-muted);">/ @Model.TotalListings total</span>
                </div>
                <div style="font-size: 11px; color: var(--rk-text-muted); margin-top: 2px;">@Model.TotalUnits total inventory units</div>
            </div>

            <div class="rk-card rk-card-elevated" style="padding: var(--rk-space-4); border-left: 4px solid #f59e0b;">
                <div style="font-size: var(--rk-font-size-xs); color: var(--rk-text-muted); text-transform: uppercase; font-weight: 600;">Pending Approval</div>
                <div style="font-size: var(--rk-font-size-2xl); font-weight: 800; color: #b45309; margin-top: 4px;">
                    @Model.PendingApprovalCount
                </div>
                <div style="font-size: 11px; color: var(--rk-text-muted); margin-top: 2px;"><a asp-action="Bookings" style="color: inherit; text-decoration: underline;">Review requests</a></div>
            </div>

            <div class="rk-card rk-card-elevated" style="padding: var(--rk-space-4); border-left: 4px solid var(--rk-teal-600);">
                <div style="font-size: var(--rk-font-size-xs); color: var(--rk-text-muted); text-transform: uppercase; font-weight: 600;">Awaiting Handover</div>
                <div style="font-size: var(--rk-font-size-2xl); font-weight: 800; color: var(--rk-teal-700); margin-top: 4px;">
                    @Model.ConfirmedCount
                </div>
                <div style="font-size: 11px; color: var(--rk-text-muted); margin-top: 2px;">Ready for counter pickup</div>
            </div>

            <div class="rk-card rk-card-elevated" style="padding: var(--rk-space-4); border-left: 4px solid #3b82f6;">
                <div style="font-size: var(--rk-font-size-xs); color: var(--rk-text-muted); text-transform: uppercase; font-weight: 600;">Active on Rent</div>
                <div style="font-size: var(--rk-font-size-2xl); font-weight: 800; color: #1d4ed8; margin-top: 4px;">
                    @Model.ActiveRentalsCount
                </div>
                <div style="font-size: 11px; color: var(--rk-text-muted); margin-top: 2px;">In customer possession</div>
            </div>

            <div class="rk-card rk-card-elevated" style="padding: var(--rk-space-4); border-left: 4px solid #ef4444;">
                <div style="font-size: var(--rk-font-size-xs); color: var(--rk-text-muted); text-transform: uppercase; font-weight: 600;">In Maintenance</div>
                <div style="font-size: var(--rk-font-size-2xl); font-weight: 800; color: #b91c1c; margin-top: 4px;">
                    @Model.UnderMaintenanceUnits
                </div>
                <div style="font-size: 11px; color: var(--rk-text-muted); margin-top: 2px;">Units blocked for service</div>
            </div>
        </div>

        <!-- Main Dashboard Split Grid -->
        <div style="display: grid; grid-template-columns: 2fr 1fr; gap: var(--rk-space-5); margin-bottom: var(--rk-space-6); align-items: flex-start;">
            <!-- Left: Recent Store Orders -->
            <div class="rk-card rk-card-elevated" style="padding: 0; overflow: hidden;">
                <div style="padding: var(--rk-space-4) var(--rk-space-5); border-bottom: 1px solid var(--rk-border-light); background: var(--rk-neutral-50); display: flex; justify-content: space-between; align-items: center;">
                    <h2 style="font-size: var(--rk-font-size-base); font-weight: 700; color: var(--rk-navy-900); margin-bottom: 0;">
                        Store Rental Bookings & Vouchers
                    </h2>
                    <a asp-action="Bookings" class="rk-btn rk-btn-outline rk-btn-sm" style="font-size: 12px;">
                        Manage All Orders &rarr;
                    </a>
                </div>

                @if (Model.RecentBookingGroups != null && Model.RecentBookingGroups.Any())
                {
                    <div style="overflow-x: auto;">
                        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: var(--rk-font-size-sm);">
                            <thead>
                                <tr style="border-bottom: 1px solid var(--rk-border-light); background: var(--rk-neutral-50); color: var(--rk-text-secondary); font-size: var(--rk-font-size-xs); text-transform: uppercase;">
                                    <th style="padding: var(--rk-space-3) var(--rk-space-4);">Group #</th>
                                    <th style="padding: var(--rk-space-3) var(--rk-space-4);">Customer</th>
                                    <th style="padding: var(--rk-space-3) var(--rk-space-4);">Rental Window</th>
                                    <th style="padding: var(--rk-space-3) var(--rk-space-4); text-align: right;">Rental (₹)</th>
                                    <th style="padding: var(--rk-space-3) var(--rk-space-4);">Status</th>
                                    <th style="padding: var(--rk-space-3) var(--rk-space-4); text-align: right;">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var group in Model.RecentBookingGroups)
                                {
                                    <tr style="border-bottom: 1px solid var(--rk-border-light); vertical-align: middle;">
                                        <td style="padding: var(--rk-space-3) var(--rk-space-4); font-weight: 700; color: var(--rk-navy-900);">
                                            #@group.GroupNumber
                                            <div style="font-size: 11px; color: var(--rk-text-muted);">@group.CreatedAtUtc.ToString("dd MMM yyyy")</div>
                                        </td>
                                        <td style="padding: var(--rk-space-3) var(--rk-space-4);">
                                            <div style="font-weight: 600; color: var(--rk-navy-900);">@group.CustomerName</div>
                                            <div style="font-size: 11px; color: var(--rk-text-muted);">@group.ItemsCount item(s)</div>
                                        </td>
                                        <td style="padding: var(--rk-space-3) var(--rk-space-4); font-size: var(--rk-font-size-xs);">
                                            @group.EarliestStartDate.ToString("dd MMM") &rarr; @group.LatestEndDate.ToString("dd MMM yyyy")
                                        </td>
                                        <td style="padding: var(--rk-space-3) var(--rk-space-4); text-align: right; font-weight: 700; color: var(--rk-teal-700);">
                                            @group.SubtotalRentalFee.ToInr()
                                        </td>
                                        <td style="padding: var(--rk-space-3) var(--rk-space-4);">
                                            <span class="rk-badge" style="font-size: 11px;">@group.Status</span>
                                        </td>
                                        <td style="padding: var(--rk-space-3) var(--rk-space-4); text-align: right;">
                                            <a asp-action="BookingGroupDetails" asp-route-id="@group.Id" class="rk-btn rk-btn-primary rk-btn-sm" style="font-size: 11px; padding: 0.25rem 0.5rem;">
                                                Manage
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div style="padding: var(--rk-space-8); text-align: center;">
                        <div style="font-size: 32px; margin-bottom: var(--rk-space-2);">📋</div>
                        <div style="font-size: var(--rk-font-size-base); font-weight: 600; color: var(--rk-navy-900); margin-bottom: 4px;">No rental orders yet</div>
                        <p style="font-size: var(--rk-font-size-sm); color: var(--rk-text-muted); margin-bottom: var(--rk-space-4);">
                            When customers book equipment from your storefront, orders appear here for approval and counter handover.
                        </p>
                        <a asp-action="Equipment" class="rk-btn rk-btn-teal rk-btn-sm">
                            View Equipment Listings
                        </a>
                    </div>
                }
            </div>

            <!-- Right: Store Location & Quick Links -->
            <div style="display: flex; flex-direction: column; gap: var(--rk-space-5);">
                <!-- Store Pickup Location Card -->
                <div class="rk-card rk-card-elevated" style="padding: var(--rk-space-5);">
                    <h2 style="font-size: var(--rk-font-size-base); font-weight: 700; color: var(--rk-navy-900); margin-bottom: var(--rk-space-3);">Store Counter Info</h2>
                    <div style="display: flex; flex-direction: column; gap: var(--rk-space-3); font-size: var(--rk-font-size-sm);">
                        <div>
                            <div style="color: var(--rk-text-muted); font-size: var(--rk-font-size-xs);">Phone</div>
                            <div style="font-weight: 600; color: var(--rk-navy-900);">@Model.ContactPhone</div>
                        </div>
                        <div>
                            <div style="color: var(--rk-text-muted); font-size: var(--rk-font-size-xs);">Physical Storefront Address</div>
                            <div style="font-weight: 600; color: var(--rk-navy-900);">@Model.Address</div>
                        </div>
                        <div>
                            <div style="color: var(--rk-text-muted); font-size: var(--rk-font-size-xs);">Operating Hours</div>
                            <div style="font-weight: 600; color: var(--rk-navy-900);">@Model.OperatingHours</div>
                        </div>
                    </div>
                    <div style="margin-top: var(--rk-space-4); border-top: 1px solid var(--rk-border-light); padding-top: var(--rk-space-3);">
                        <a asp-action="Profile" style="color: var(--rk-teal-600); font-size: var(--rk-font-size-xs); font-weight: 600; text-decoration: none;">
                            Update Store Details &rarr;
                        </a>
                    </div>
                </div>

                <!-- Fast Actions Card -->
                <div class="rk-card" style="padding: var(--rk-space-5);">
                    <h3 style="font-size: var(--rk-font-size-sm); font-weight: 700; color: var(--rk-navy-900); text-transform: uppercase; margin-bottom: var(--rk-space-3);">
                        Quick Actions
                    </h3>
                    <div style="display: flex; flex-direction: column; gap: var(--rk-space-2); font-size: var(--rk-font-size-sm);">
                        <a asp-action="Equipment" style="display: flex; align-items: center; justify-content: space-between; padding: var(--rk-space-2) 0; color: var(--rk-navy-900); text-decoration: none; border-bottom: 1px solid var(--rk-border-light);">
                            <span>Manage Equipment & Photos</span>
                            <span style="color: var(--rk-teal-600);">&rarr;</span>
                        </a>
                        <a asp-action="Bookings" style="display: flex; align-items: center; justify-content: space-between; padding: var(--rk-space-2) 0; color: var(--rk-navy-900); text-decoration: none; border-bottom: 1px solid var(--rk-border-light);">
                            <span>Pending Reservation Orders</span>
                            <span style="color: var(--rk-teal-600);">&rarr;</span>
                        </a>
                        <a asp-controller="Documents" asp-action="Index" style="display: flex; align-items: center; justify-content: space-between; padding: var(--rk-space-2) 0; color: var(--rk-navy-900); text-decoration: none;">
                            <span>Store Rental Agreements & Invoices</span>
                            <span style="color: var(--rk-teal-600);">&rarr;</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
