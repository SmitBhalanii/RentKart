@using RentKart.Core.Enums
@model RentKart.Web.Models.Business.EditEquipmentViewModel
@{
    ViewData["Title"] = $"Edit {Model.Title} - RentKart Business";
}

<div class="rk-section" style="padding-top: var(--rk-space-6); padding-bottom: var(--rk-space-8);">
    <div class="rk-container" style="max-width: 840px;">
        <!-- Breadcrumb Navigation -->
        <nav aria-label="breadcrumb" style="margin-bottom: var(--rk-space-3);">
            <ol style="display: flex; gap: var(--rk-space-2); list-style: none; padding: 0; margin: 0; font-size: var(--rk-font-size-xs); color: var(--rk-color-slate-500);">
                <li><a asp-action="Dashboard" style="color: var(--rk-color-teal-600); text-decoration: none;">Dashboard</a></li>
                <li>&rsaquo;</li>
                <li><a asp-action="Equipment" style="color: var(--rk-color-teal-600); text-decoration: none;">Equipment</a></li>
                <li>&rsaquo;</li>
                <li style="color: var(--rk-color-navy-900); font-weight: 600;">Edit Listing</li>
            </ol>
        </nav>

        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: var(--rk-space-3); margin-bottom: var(--rk-space-5);">
            <div>
                <h1 style="font-size: var(--rk-font-size-3xl); font-weight: 800; color: var(--rk-color-navy-900); margin-bottom: 4px;">
                    Edit Equipment Listing
                </h1>
                <p style="color: var(--rk-color-slate-500); font-size: var(--rk-font-size-sm); margin-bottom: 0;">
                    Update rates in ₹ INR, inventory stock, condition, specifications, and listing photos.
                </p>
            </div>
            <div>
                <a asp-action="Maintenance" asp-route-id="@Model.EquipmentId" class="rk-btn rk-btn-outline rk-btn-sm">
                    Manage Maintenance Schedules &rarr;
                </a>
            </div>
        </div>

        <form method="post" asp-action="EditEquipment" asp-route-id="@Model.EquipmentId" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="EquipmentId" />
            <input type="hidden" asp-for="BusinessId" />
            <input type="hidden" asp-for="RowVersion" />

            <div asp-validation-summary="ModelOnly" class="rk-alert rk-alert-error" role="alert" style="margin-bottom: var(--rk-space-5);"></div>

            <!-- Card 1: Equipment Specification -->
            <div class="rk-card rk-card-elevated" style="padding: var(--rk-space-6); margin-bottom: var(--rk-space-5);">
                <h2 style="font-size: var(--rk-font-size-base); font-weight: 700; color: var(--rk-color-navy-900); margin-bottom: var(--rk-space-4); border-bottom: 1px solid var(--rk-border-light); padding-bottom: var(--rk-space-2);">
                    Equipment Information & Description
                </h2>

                <div class="rk-form-group" style="margin-bottom: var(--rk-space-4);">
                    <label asp-for="Title" class="rk-form-label"></label>
                    <input asp-for="Title" class="rk-form-control" />
                    <span asp-validation-for="Title" class="rk-form-error"></span>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--rk-space-4); margin-bottom: var(--rk-space-4);">
                    <div class="rk-form-group">
                        <label asp-for="CategoryId" class="rk-form-label"></label>
                        <select asp-for="CategoryId" class="rk-form-control">
                            @foreach (var cat in Model.AvailableCategories)
                            {
                                <option value="@cat.Id" selected="@(cat.Id == Model.CategoryId ? "selected" : null)">@cat.Name</option>
                            }
                        </select>
                        <span asp-validation-for="CategoryId" class="rk-form-error"></span>
                    </div>

                    <div class="rk-form-group">
                        <label asp-for="Condition" class="rk-form-label"></label>
                        <select asp-for="Condition" class="rk-form-control" asp-items="Html.GetEnumSelectList<EquipmentCondition>()">
                        </select>
                        <span asp-validation-for="Condition" class="rk-form-error"></span>
                    </div>
                </div>

                <div class="rk-form-group" style="margin-bottom: 0;">
                    <label asp-for="Description" class="rk-form-label"></label>
                    <textarea asp-for="Description" class="rk-form-control" rows="5"></textarea>
                    <span asp-validation-for="Description" class="rk-form-error"></span>
                </div>
            </div>

            <!-- Card 2: Pricing (₹ INR) & Total Rentable Inventory -->
            <div class="rk-card rk-card-elevated" style="padding: var(--rk-space-6); margin-bottom: var(--rk-space-5);">
                <h2 style="font-size: var(--rk-font-size-base); font-weight: 700; color: var(--rk-color-navy-900); margin-bottom: var(--rk-space-4); border-bottom: 1px solid var(--rk-border-light); padding-bottom: var(--rk-space-2);">
                    Pricing Rates (₹ INR) & Total Inventory
                </h2>

                <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: var(--rk-space-4); margin-bottom: var(--rk-space-4);">
                    <div class="rk-form-group">
                        <label asp-for="DailyRentalRate" class="rk-form-label"></label>
                        <div style="position: relative;">
                            <span style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--rk-color-slate-500); font-weight: 700; font-size: 1.1rem;">₹</span>
                            <input asp-for="DailyRentalRate" class="rk-form-control" type="number" step="1" min="1" style="padding-left: 28px;" />
                        </div>
                        <span asp-validation-for="DailyRentalRate" class="rk-form-error"></span>
                    </div>

                    <div class="rk-form-group">
                        <label asp-for="SecurityDeposit" class="rk-form-label"></label>
                        <div style="position: relative;">
                            <span style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--rk-color-slate-500); font-weight: 700; font-size: 1.1rem;">₹</span>
                            <input asp-for="SecurityDeposit" class="rk-form-control" type="number" step="1" min="0" style="padding-left: 28px;" />
                        </div>
                        <span asp-validation-for="SecurityDeposit" class="rk-form-error"></span>
                    </div>

                    <div class="rk-form-group">
                        <label asp-for="TotalQuantity" class="rk-form-label"></label>
                        <input asp-for="TotalQuantity" class="rk-form-control" type="number" min="1" max="10000" />
                        <span asp-validation-for="TotalQuantity" class="rk-form-error"></span>
                    </div>
                </div>

                <div style="margin-top: var(--rk-space-4); padding-top: var(--rk-space-3); border-top: 1px solid var(--rk-border-light);">
                    <label style="display: flex; align-items: center; gap: 0.6rem; cursor: pointer; font-size: var(--rk-font-size-sm); font-weight: 600; color: var(--rk-color-navy-900);">
                        <input asp-for="IsActive" type="checkbox" style="width: 18px; height: 18px; accent-color: var(--rk-color-teal-600);" />
                        <span>Listing is Active and searchable in customer discovery</span>
                    </label>
                </div>
            </div>

            <!-- Form Action Buttons -->
            <div style="display: flex; justify-content: space-between; align-items: center; gap: var(--rk-space-3); margin-bottom: var(--rk-space-6);">
                <div>
                    <button type="submit" form="deleteEquipmentForm" class="rk-btn rk-btn-outline" style="color: #dc2626; border-color: #fca5a5;" onclick="return confirm('Are you sure you want to delete this equipment listing?');">
                        Delete Listing
                    </button>
                </div>
                <div style="display: flex; gap: var(--rk-space-3);">
                    <a asp-action="Equipment" class="rk-btn rk-btn-outline">Cancel</a>
                    <button type="submit" class="rk-btn rk-btn-teal" style="padding-left: var(--rk-space-6); padding-right: var(--rk-space-6); font-weight: 700;">
                        Save Changes
                    </button>
                </div>
            </div>
        </form>

        <form id="deleteEquipmentForm" method="post" asp-action="DeleteEquipment" asp-route-id="@Model.EquipmentId" style="display: none;">
            @Html.AntiForgeryToken()
        </form>

        <!-- Media & Photo Gallery Manager -->
        <div class="rk-card rk-card-elevated" style="padding: var(--rk-space-6); margin-bottom: var(--rk-space-6);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--rk-space-4); border-bottom: 1px solid var(--rk-border-light); padding-bottom: var(--rk-space-2);">
                <h2 style="font-size: var(--rk-font-size-base); font-weight: 700; color: var(--rk-color-navy-900); margin-bottom: 0;">
                    Photo Gallery Manager (@Model.ExistingImages.Count photos)
                </h2>
            </div>

            @if (Model.ExistingImages.Count > 0)
            {
                <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: var(--rk-space-4); margin-bottom: var(--rk-space-5);">
                    @foreach (var img in Model.ExistingImages)
                    {
                        <div style="border: 1px solid var(--rk-border-light); border-radius: var(--rk-radius-md); overflow: hidden; position: relative; background: #ffffff;">
                            <img src="@img.ImageUrl" alt="Equipment photo" style="width: 100%; height: 120px; object-fit: cover;" onerror="this.onerror=null; this.src='/images/placeholder-equipment.svg';" />
                            
                            @if (img.IsPrimary)
                            {
                                <span class="rk-badge rk-badge-success" style="position: absolute; top: 6px; left: 6px; font-size: 10px;">Primary Photo</span>
                            }

                            <div style="padding: var(--rk-space-2); display: flex; justify-content: space-between; align-items: center; background: var(--rk-color-slate-50);">
                                @if (!img.IsPrimary)
                                {
                                    <form method="post" asp-action="SetPrimaryImage" asp-route-equipmentId="@Model.EquipmentId" asp-route-imageId="@img.Id">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="rk-btn rk-btn-outline rk-btn-sm" style="font-size: 11px; padding: 2px 6px;">Set Primary</button>
                                    </form>
                                }
                                else
                                {
                                    <span style="font-size: 11px; color: var(--rk-color-teal-700); font-weight: 600;">Main Photo</span>
                                }

                                <form method="post" asp-action="DeleteImage" asp-route-equipmentId="@Model.EquipmentId" asp-route-imageId="@img.Id">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="rk-btn rk-btn-outline rk-btn-sm" style="font-size: 11px; padding: 2px 6px; color: var(--rk-color-error-600);" title="Remove photo" onclick="return confirm('Remove this photo?');">
                                        Delete
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div style="text-align: center; padding: var(--rk-space-4); background: var(--rk-color-slate-50); border-radius: var(--rk-radius-md); margin-bottom: var(--rk-space-4);">
                    <img src="/images/placeholder-equipment.svg" alt="No photos" style="width: 140px; height: 90px; margin-bottom: 8px;" />
                    <p style="color: var(--rk-color-slate-500); font-size: var(--rk-font-size-sm); margin-bottom: 0;">
                        No photos currently attached to this listing. Upload a photo below to help customers discover your equipment.
                    </p>
                </div>
            }

            <!-- Add Image Form: Supports Direct Upload or URL -->
            <form method="post" asp-action="AddImage" asp-route-equipmentId="@Model.EquipmentId" enctype="multipart/form-data" style="background: var(--rk-color-slate-50); padding: var(--rk-space-4); border-radius: var(--rk-radius-md); border: 1px solid var(--rk-border-light);">
                @Html.AntiForgeryToken()
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--rk-space-3); margin-bottom: var(--rk-space-3);">
                    <div>
                        <label class="rk-form-label" style="font-size: var(--rk-font-size-xs);">Upload Photo File (JPG, PNG, WebP up to 5MB)</label>
                        <input type="file" name="imageFile" accept=".jpg,.jpeg,.png,.webp" class="rk-form-control" />
                    </div>
                    <div>
                        <label class="rk-form-label" style="font-size: var(--rk-font-size-xs);">Or Add by Photo Web URL</label>
                        <input type="url" name="imageUrl" class="rk-form-control" placeholder="https://example.com/photos/item.jpg" />
                    </div>
                </div>
                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: var(--rk-space-2);">
                    <label style="font-size: var(--rk-font-size-xs); display: flex; align-items: center; gap: 0.35rem; cursor: pointer; color: var(--rk-color-navy-900);">
                        <input type="checkbox" name="isPrimary" value="true" style="accent-color: var(--rk-color-teal-600);" />
                        Set as Primary Catalog Photo
                    </label>
                    <button type="submit" class="rk-btn rk-btn-teal rk-btn-sm" style="font-weight: 700;">
                        + Upload / Add Photo
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
