@using RentKart.Core.Enums
@using RentKart.Core.Interfaces
@model List<NotificationDto>
@{
    ViewData["Title"] = "Notifications";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalCount = ViewBag.TotalCount ?? 0;
    int unreadCount = ViewBag.UnreadCount ?? 0;
    bool unreadOnly = ViewBag.UnreadOnly ?? false;
}

<div class="rk-container" style="padding-top: var(--rk-space-6); padding-bottom: var(--rk-space-12); max-width: 900px;">
    <!-- Breadcrumb -->
    <nav class="rk-breadcrumb" aria-label="Breadcrumb" style="margin-bottom: var(--rk-space-4);">
        <ol>
            <li><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li aria-current="page">Notifications</li>
        </ol>
    </nav>

    <!-- Header & Controls -->
    <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--rk-space-4); margin-bottom: var(--rk-space-6);">
        <div>
            <h1 class="rk-page-title" style="margin: 0; display: flex; align-items: center; gap: 0.5rem;">
                Notifications
                @if (unreadCount > 0)
                {
                    <span class="rk-badge rk-badge-primary" style="font-size: 0.875rem;">@unreadCount Unread</span>
                }
            </h1>
            <p class="rk-text-muted" style="margin-top: 0.25rem;">Stay updated on your booking requests, equipment handover, returns, and agreements.</p>
        </div>

        <div style="display: flex; align-items: center; gap: var(--rk-space-2);">
            <div class="rk-btn-group" role="group">
                <a asp-action="Index" asp-route-unreadOnly="false" class="rk-btn rk-btn-sm @(!unreadOnly ? "rk-btn-primary" : "rk-btn-outline")">
                    All (@totalCount)
                </a>
                <a asp-action="Index" asp-route-unreadOnly="true" class="rk-btn rk-btn-sm @(unreadOnly ? "rk-btn-primary" : "rk-btn-outline")">
                    Unread Only (@unreadCount)
                </a>
            </div>

            @if (unreadCount > 0)
            {
                <form asp-action="MarkAllAsRead" method="post" style="display: inline; margin: 0;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="rk-btn rk-btn-outline rk-btn-sm" title="Mark all notifications as read">
                        Mark All Read
                    </button>
                </form>
            }
        </div>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="rk-card" style="text-align: center; padding: var(--rk-space-12) var(--rk-space-6);">
            <div style="font-size: 3rem; margin-bottom: var(--rk-space-3); color: var(--rk-teal-500);">✓</div>
            <h3 style="font-size: 1.25rem; font-weight: 700; color: var(--rk-navy-900); margin-bottom: var(--rk-space-2);">All Caught Up!</h3>
            <p class="rk-text-muted" style="max-width: 450px; margin: 0 auto var(--rk-space-6);">
                @(unreadOnly ? "You have no unread notifications at this time." : "You don't have any notifications yet. They will appear here when you reserve or manage equipment.")
            </p>
            @if (unreadOnly)
            {
                <a asp-action="Index" asp-route-unreadOnly="false" class="rk-btn rk-btn-primary rk-btn-sm">View All Notifications</a>
            }
        </div>
    }
    else
    {
        <div style="display: flex; flex-direction: column; gap: var(--rk-space-3);">
            @foreach (var n in Model)
            {
                <div class="rk-card" style="padding: var(--rk-space-4); display: flex; flex-direction: column; gap: 0.5rem; border-left: 4px solid @(!n.IsRead ? "var(--rk-teal-500)" : "transparent"); background-color: @(!n.IsRead ? "rgba(13, 148, 136, 0.04)" : "#ffffff");">
                    <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: var(--rk-space-3);">
                        <div style="display: flex; align-items: flex-start; gap: var(--rk-space-3);">
                            <div style="width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background-color: @(!n.IsRead ? "var(--rk-teal-100)" : "var(--rk-neutral-100)"); color: @(!n.IsRead ? "var(--rk-teal-700)" : "var(--rk-neutral-600)"); flex-shrink: 0;">
                                @switch (n.Type)
                                {
                                    case NotificationType.BookingConfirmed:
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                        break;
                                    case NotificationType.BookingRejected:
                                    case NotificationType.BookingCancelled:
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
                                        break;
                                    case NotificationType.EquipmentHandedOver:
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
                                        break;
                                    case NotificationType.EquipmentReturned:
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
                                        break;
                                    case NotificationType.DocumentReady:
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
                                        break;
                                    default:
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
                                        break;
                                }
                            </div>
                            <div>
                                <div style="display: flex; align-items: center; gap: 0.5rem;">
                                    <h4 style="margin: 0; font-size: 1rem; font-weight: @(!n.IsRead ? "700" : "600"); color: var(--rk-navy-900);">
                                        @n.Title
                                    </h4>
                                    @if (!n.IsRead)
                                    {
                                        <span class="rk-badge rk-badge-teal" style="font-size: 0.7rem; padding: 0.1rem 0.35rem;">New</span>
                                    }
                                </div>
                                <p style="margin: 0.35rem 0 0 0; font-size: 0.9rem; color: var(--rk-neutral-700); line-height: 1.4;">
                                    @n.Message
                                </p>
                                <span class="rk-text-muted" style="font-size: 0.8rem; display: block; margin-top: 0.4rem;">
                                    @n.CreatedAtUtc.ToString("MMM dd, yyyy h:mm tt") UTC
                                </span>
                            </div>
                        </div>

                        <!-- Actions -->
                        <div style="display: flex; align-items: center; gap: 0.35rem; flex-shrink: 0;">
                            @if (!string.IsNullOrWhiteSpace(n.TargetUrl))
                            {
                                <a href="@n.TargetUrl" class="rk-btn rk-btn-primary rk-btn-sm" style="padding: 0.25rem 0.65rem; font-size: 0.8rem;">
                                    View
                                </a>
                            }
                            @if (!n.IsRead)
                            {
                                <form asp-action="MarkAsRead" asp-route-id="@n.Id" method="post" style="display: inline; margin: 0;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="rk-btn rk-btn-outline rk-btn-sm" style="padding: 0.25rem 0.5rem; font-size: 0.8rem;" title="Mark as read">
                                        Mark Read
                                    </button>
                                </form>
                            }
                            <form asp-action="Delete" asp-route-id="@n.Id" method="post" style="display: inline; margin: 0;">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="rk-btn rk-btn-outline rk-btn-sm" style="padding: 0.25rem 0.5rem; font-size: 0.8rem; color: var(--rk-danger);" title="Dismiss notification" onclick="return confirm('Dismiss this notification?');">
                                    &times;
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (totalPages > 1)
        {
            <div style="display: flex; justify-content: center; align-items: center; gap: var(--rk-space-2); margin-top: var(--rk-space-6);">
                @if (currentPage > 1)
                {
                    <a asp-action="Index" asp-route-unreadOnly="@unreadOnly" asp-route-page="@(currentPage - 1)" class="rk-btn rk-btn-outline rk-btn-sm">&larr; Previous</a>
                }
                <span class="rk-text-muted" style="font-size: 0.875rem;">Page @currentPage of @totalPages</span>
                @if (currentPage < totalPages)
                {
                    <a asp-action="Index" asp-route-unreadOnly="@unreadOnly" asp-route-page="@(currentPage + 1)" class="rk-btn rk-btn-outline rk-btn-sm">Next &rarr;</a>
                }
            </div>
        }
    }
</div>
