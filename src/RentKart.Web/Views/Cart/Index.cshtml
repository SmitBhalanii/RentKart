@model RentKart.Core.Interfaces.CartSummaryDto
@{
    ViewData["Title"] = "My Rental Cart";
    var today = DateOnly.FromDateTime(DateTime.UtcNow).ToString("yyyy-MM-dd");
}

<div class="rk-container" style="padding-top: var(--rk-space-8); padding-bottom: var(--rk-space-12);">
    <!-- Breadcrumb -->
    <nav style="font-size: var(--rk-font-size-xs); color: var(--rk-text-muted); margin-bottom: var(--rk-space-4);">
        <a asp-controller="Home" asp-action="Index" style="color: var(--rk-text-secondary); text-decoration: none;">Home</a>
        <span style="margin: 0 var(--rk-space-2);">&rsaquo;</span>
        <a asp-controller="Catalog" asp-action="Index" style="color: var(--rk-text-secondary); text-decoration: none;">Catalog</a>
        <span style="margin: 0 var(--rk-space-2);">&rsaquo;</span>
        <span style="color: var(--rk-navy-900); font-weight: 600;">Rental Cart</span>
    </nav>

    <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: var(--rk-space-6); flex-wrap: wrap; gap: var(--rk-space-4);">
        <div>
            <h1 style="font-size: var(--rk-font-size-2xl); font-weight: 800; color: var(--rk-navy-900); margin-bottom: 0.25rem;">
                My Rental Cart
            </h1>
            <p style="color: var(--rk-text-secondary); font-size: var(--rk-font-size-sm); margin-bottom: 0;">
                Review items, rental periods, and pickup locations across participating businesses.
            </p>
        </div>
        @if (Model.Items.Count > 0)
        {
            <form asp-action="Clear" method="post" onsubmit="return confirm('Are you sure you want to empty your rental cart?');">
                <button type="submit" class="rk-btn rk-btn-outline rk-btn-sm" style="color: var(--rk-error); border-color: var(--rk-border-light);">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                    Empty Cart
                </button>
            </form>
        }
    </div>

    @if (Model.AvailabilityWarnings.Count > 0)
    {
        <div style="background: #fef2f2; border: 1px solid #fecaca; border-radius: var(--rk-radius-md); padding: var(--rk-space-4); margin-bottom: var(--rk-space-6); color: #991b1b; font-size: var(--rk-font-size-sm);">
            <div style="font-weight: 700; margin-bottom: 0.25rem; display: flex; align-items: center; gap: 0.5rem;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                Inventory Notice: Some items require adjustment before checkout
            </div>
            <ul style="margin: 0; padding-left: 1.5rem;">
                @foreach (var warning in Model.AvailabilityWarnings)
                {
                    <li>@warning</li>
                }
            </ul>
        </div>
    }

    @if (Model.Items.Count == 0)
    {
        <!-- Empty Cart State -->
        <div class="rk-card" style="padding: var(--rk-space-12); text-align: center; max-width: 600px; margin: 2rem auto;">
            <div style="width: 72px; height: 72px; border-radius: 50%; background: var(--rk-teal-50); display: flex; align-items: center; justify-content: center; margin: 0 auto var(--rk-space-4); color: var(--rk-teal-600);">
                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                    <circle cx="8" cy="21" r="1"></circle>
                    <circle cx="19" cy="21" r="1"></circle>
                    <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"></path>
                </svg>
            </div>
            <h2 style="font-size: var(--rk-font-size-xl); font-weight: 700; color: var(--rk-navy-900); margin-bottom: var(--rk-space-2);">Your rental cart is empty</h2>
            <p style="color: var(--rk-text-secondary); font-size: var(--rk-font-size-sm); line-height: 1.6; margin-bottom: var(--rk-space-6);">
                Browse verified local equipment from approved businesses across cameras, tools, audio gear, and outdoor equipment.
            </p>
            <a asp-controller="Catalog" asp-action="Index" class="rk-btn rk-btn-primary" style="padding: 0.75rem 2rem;">
                Explore Catalog &rarr;
            </a>
        </div>
    }
    else
    {
        <div style="display: grid; grid-template-columns: 1fr 340px; gap: var(--rk-space-8); align-items: start;">
            <!-- Left: Items Grouped by Store -->
            <div style="display: flex; flex-direction: column; gap: var(--rk-space-6);">
                @foreach (var group in Model.BusinessGroups)
                {
                    <div class="rk-card" style="overflow: hidden; border: 1px solid var(--rk-border-light);">
                        <!-- Store Header -->
                        <div style="background: var(--rk-neutral-50); border-bottom: 1px solid var(--rk-border-light); padding: var(--rk-space-4) var(--rk-space-5); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
                            <div>
                                <div style="display: flex; align-items: center; gap: 0.5rem;">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--rk-teal-600)" stroke-width="2"><path d="m2 7 4.41-4.41A2 2 0 0 1 7.83 2h8.34a2 2 0 0 1 1.42.59L22 7"></path><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path><path d="M15 22v-4a2 2 0 0 0-2-2h-2a2 2 0 0 0-2 2v4"></path><path d="M2 7h20"></path></svg>
                                    <span style="font-weight: 700; color: var(--rk-navy-900); font-size: var(--rk-font-size-base);">@group.BusinessName</span>
                                    <span class="rk-badge rk-badge-info" style="font-size: var(--rk-font-size-xs);">Pickup Store</span>
                                </div>
                                <div style="font-size: var(--rk-font-size-xs); color: var(--rk-text-muted); margin-top: 0.25rem;">
                                    @group.BusinessAddressLine, @group.BusinessCity &bull; Hours: @group.OperatingHours
                                </div>
                            </div>
                            <div style="font-size: var(--rk-font-size-xs); color: var(--rk-text-secondary); text-align: right;">
                                <div>Subtotal: <strong>$@group.GroupRentalSubtotal.ToString("F2")</strong></div>
                                <div>Deposit: <strong>$@group.GroupDepositSubtotal.ToString("F2")</strong></div>
                            </div>
                        </div>

                        <!-- Store Items -->
                        <div style="padding: var(--rk-space-5); display: flex; flex-direction: column; gap: var(--rk-space-5);">
                            @foreach (var item in group.Items)
                            {
                                <div style="display: grid; grid-template-columns: 80px 1fr auto; gap: var(--rk-space-4); padding-bottom: var(--rk-space-4); border-bottom: 1px solid var(--rk-border-light);">
                                    <!-- Thumbnail -->
                                    <div style="width: 80px; height: 80px; border-radius: var(--rk-radius-md); overflow: hidden; background: var(--rk-neutral-100); flex-shrink: 0;">
                                        @if (!string.IsNullOrWhiteSpace(item.PrimaryImageUrl))
                                        {
                                            <img src="@item.PrimaryImageUrl" alt="@item.Title" style="width: 100%; height: 100%; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: var(--rk-text-muted);">
                                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                                            </div>
                                        }
                                    </div>

                                    <!-- Details & Date Inputs Form -->
                                    <div>
                                        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.25rem;">
                                            <a asp-controller="Catalog" asp-action="Details" asp-route-id="@item.EquipmentId" style="font-weight: 700; color: var(--rk-navy-900); text-decoration: none; font-size: var(--rk-font-size-base);">
                                                @item.Title
                                            </a>
                                            @if (!item.IsAvailable)
                                            {
                                                <span class="rk-badge" style="background: #fee2e2; color: #991b1b;">Unavailable</span>
                                            }
                                            else if (item.AvailableQuantity <= 2)
                                            {
                                                <span class="rk-badge" style="background: #fef3c7; color: #92400e;">Only @item.AvailableQuantity left</span>
                                            }
                                            else
                                            {
                                                <span class="rk-badge rk-badge-success">In Stock (@item.AvailableQuantity available)</span>
                                            }
                                        </div>

                                        <div style="font-size: var(--rk-font-size-xs); color: var(--rk-text-muted); margin-bottom: var(--rk-space-3);">
                                            Rate: $@item.DailyRentalRate.ToString("F2")/day &bull; Deposit: $@item.SecurityDepositPerUnit.ToString("F2")/unit (Refundable)
                                        </div>

                                        <!-- Update Form -->
                                        <form asp-action="Update" method="post" style="display: flex; align-items: flex-end; gap: var(--rk-space-2); flex-wrap: wrap;">
                                            <input type="hidden" name="equipmentId" value="@item.EquipmentId" />
                                            <div>
                                                <label style="font-size: 11px; font-weight: 600; color: var(--rk-text-muted); display: block; margin-bottom: 2px;">From</label>
                                                <input type="date" name="startDate" value="@item.StartDate.ToString("yyyy-MM-dd")" min="@today" class="rk-form-control" style="padding: 0.35rem 0.5rem; font-size: var(--rk-font-size-xs); width: 130px;" />
                                            </div>
                                            <div>
                                                <label style="font-size: 11px; font-weight: 600; color: var(--rk-text-muted); display: block; margin-bottom: 2px;">To</label>
                                                <input type="date" name="endDate" value="@item.EndDate.ToString("yyyy-MM-dd")" min="@today" class="rk-form-control" style="padding: 0.35rem 0.5rem; font-size: var(--rk-font-size-xs); width: 130px;" />
                                            </div>
                                            <div>
                                                <label style="font-size: 11px; font-weight: 600; color: var(--rk-text-muted); display: block; margin-bottom: 2px;">Qty</label>
                                                <input type="number" name="quantity" value="@item.Quantity" min="1" max="100" class="rk-form-control" style="padding: 0.35rem 0.5rem; font-size: var(--rk-font-size-xs); width: 65px;" />
                                            </div>
                                            <button type="submit" class="rk-btn rk-btn-outline rk-btn-sm" style="padding: 0.35rem 0.65rem; font-size: var(--rk-font-size-xs);" title="Update rental dates or quantity">
                                                Update
                                            </button>
                                        </form>
                                    </div>

                                    <!-- Price & Remove -->
                                    <div style="text-align: right; display: flex; flex-direction: column; justify-content: space-between; align-items: flex-end;">
                                        <div>
                                            <div style="font-weight: 800; font-size: var(--rk-font-size-lg); color: var(--rk-navy-900);">
                                                $@item.ItemRentalSubtotal.ToString("F2")
                                            </div>
                                            <div style="font-size: var(--rk-font-size-xs); color: var(--rk-text-muted);">
                                                @item.DaysCount @(item.DaysCount == 1 ? "day" : "days") &bull; $@item.ItemDepositSubtotal.ToString("F2") dep
                                            </div>
                                        </div>

                                        <form asp-action="Remove" method="post" onsubmit="return confirm('Remove @item.Title from your cart?');">
                                            <input type="hidden" name="equipmentId" value="@item.EquipmentId" />
                                            <button type="submit" style="background: none; border: none; color: var(--rk-error); font-size: var(--rk-font-size-xs); cursor: pointer; display: flex; align-items: center; gap: 0.25rem; padding: 0;">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                                Remove
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Right: Order Summary Sidebar -->
            <div style="position: sticky; top: 80px;">
                <div class="rk-card rk-card-elevated" style="padding: var(--rk-space-6);">
                    <h2 style="font-size: var(--rk-font-size-base); font-weight: 700; color: var(--rk-navy-900); margin-bottom: var(--rk-space-4);">
                        Rental Order Summary
                    </h2>

                    <div style="display: flex; flex-direction: column; gap: var(--rk-space-3); font-size: var(--rk-font-size-sm); margin-bottom: var(--rk-space-5);">
                        <div style="display: flex; justify-content: space-between; color: var(--rk-text-secondary);">
                            <span>Total Units</span>
                            <span style="font-weight: 600; color: var(--rk-navy-900);">@Model.TotalItemsCount</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; color: var(--rk-text-secondary);">
                            <span>Participating Stores</span>
                            <span style="font-weight: 600; color: var(--rk-navy-900);">@Model.DistinctStoresCount</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; color: var(--rk-text-secondary);">
                            <span>Rental Fees Subtotal</span>
                            <span style="font-weight: 600; color: var(--rk-navy-900);">$@Model.TotalRentalFee.ToString("F2")</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; color: var(--rk-text-secondary);">
                            <span>Refundable Security Deposit</span>
                            <span style="font-weight: 600; color: var(--rk-navy-900);">$@Model.TotalSecurityDeposit.ToString("F2")</span>
                        </div>
                        <div style="border-top: 1px solid var(--rk-border-light); padding-top: var(--rk-space-3); display: flex; justify-content: space-between; font-size: var(--rk-font-size-base);">
                            <span style="font-weight: 700; color: var(--rk-navy-900);">Estimated Total</span>
                            <span style="font-weight: 800; color: var(--rk-teal-700); font-size: var(--rk-font-size-xl);">$@Model.GrandTotal.ToString("F2")</span>
                        </div>
                    </div>

                    <div style="background: var(--rk-neutral-50); border-radius: var(--rk-radius-md); padding: var(--rk-space-3); font-size: var(--rk-font-size-xs); color: var(--rk-text-muted); line-height: 1.5; margin-bottom: var(--rk-space-5);">
                        <div style="font-weight: 600; color: var(--rk-navy-900); margin-bottom: 2px;">In-Store Pickup Model</div>
                        You will collect and return equipment directly at each store counter. Deposits are held and refunded upon return inspection.
                    </div>

                    @if (Model.HasUnavailableItems)
                    {
                        <button disabled class="rk-btn rk-btn-primary" style="width: 100%; justify-content: center; opacity: 0.6; cursor: not-allowed;">
                            Resolve Availability Conflicts
                        </button>
                    }
                    else
                    {
                        <a asp-controller="Checkout" asp-action="Index" class="rk-btn rk-btn-primary" style="width: 100%; justify-content: center; font-size: var(--rk-font-size-base); padding: 0.75rem 1rem;">
                            Proceed to Checkout &rarr;
                        </a>
                    }

                    <div style="margin-top: var(--rk-space-4); text-align: center;">
                        <a asp-controller="Catalog" asp-action="Index" style="font-size: var(--rk-font-size-xs); color: var(--rk-teal-600); text-decoration: none; font-weight: 600;">
                            &larr; Add more equipment
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
