@{
    ViewData["Title"] = "Access Denied";
}

<div class="rk-section" style="min-height: calc(100vh - 350px); display: flex; align-items: center;">
    <div class="rk-container" style="max-width: 520px; text-align: center;">
        <div class="rk-card rk-card-elevated" style="padding: var(--rk-space-8) var(--rk-space-6);">
            <div style="width: 64px; height: 64px; border-radius: var(--rk-radius-full); background: rgba(239, 68, 68, 0.12); color: var(--rk-error); display: flex; align-items: center; justify-content: center; margin: 0 auto var(--rk-space-4);">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
                </svg>
            </div>
            
            <h1 style="font-size: var(--rk-font-size-2xl); font-weight: 800; color: var(--rk-navy-900); margin-bottom: var(--rk-space-2);">
                Access Restricted
            </h1>
            
            <p style="color: var(--rk-text-secondary); font-size: var(--rk-font-size-sm); line-height: 1.6; margin-bottom: var(--rk-space-6);">
                You do not have administrative or role-level permissions to access this protected RentKart resource. If you believe this is in error, please sign in with an authorized account or contact platform support.
            </p>

            <div style="display: flex; gap: var(--rk-space-3); justify-content: center; flex-wrap: wrap;">
                <a asp-controller="Home" asp-action="Index" class="rk-btn rk-btn-outline">
                    Back to Homepage
                </a>
                <a asp-controller="Account" asp-action="Login" class="rk-btn rk-btn-primary">
                    Sign In with Different Account
                </a>
            </div>
        </div>
    </div>
</div>
