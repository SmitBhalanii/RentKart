@model RentKart.Web.Models.Account.RegisterBusinessViewModel
@{
    ViewData["Title"] = "Business Registration";
}

<div class="rk-section" style="min-height: calc(100vh - 350px); padding-top: var(--rk-space-6); padding-bottom: var(--rk-space-8);">
    <div class="rk-container" style="max-width: 680px;">
        <div class="rk-card rk-card-elevated" style="padding: var(--rk-space-6);">
            <div style="text-align: center; margin-bottom: var(--rk-space-6);">
                <div class="rk-brand-logo" style="width: 54px; height: 54px; margin: 0 auto var(--rk-space-3); border-radius: var(--rk-radius-lg); background: var(--rk-color-teal-600); color: #fff; display: flex; align-items: center; justify-content: center;" aria-hidden="true">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                        <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                    </svg>
                </div>
                <h1 style="font-size: var(--rk-font-size-2xl); font-weight: 700; color: var(--rk-color-navy-900); margin-bottom: var(--rk-space-1);">List Your Rental Business</h1>
                <p style="color: var(--rk-color-slate-500); font-size: var(--rk-font-size-sm); margin-bottom: 0;">
                    Register your physical rental storefront to publish equipment and receive local customer bookings
                </p>
            </div>

            <div class="rk-alert rk-alert-info" style="margin-bottom: var(--rk-space-5); display: flex; gap: var(--rk-space-3); align-items: flex-start;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0; margin-top: 2px;">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="16" x2="12" y2="12"></line>
                    <line x1="12" y1="8" x2="12.01" y2="8"></line>
                </svg>
                <div style="font-size: var(--rk-font-size-xs); line-height: 1.5;">
                    <strong>Verification Process:</strong> RentKart is a trusted local marketplace. New business accounts are initialized in <em>Pending Approval</em> status. An administrator verifies your store location before equipment listings go live.
                </div>
            </div>

            <form asp-action="RegisterBusiness" method="post" id="businessRegisterForm" novalidate>
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="rk-alert rk-alert-error" role="alert" style="margin-bottom: var(--rk-space-4);"></div>

                <!-- Section 1: Business Account Credentials -->
                <h3 style="font-size: var(--rk-font-size-base); font-weight: 700; color: var(--rk-color-navy-900); margin-bottom: var(--rk-space-3); padding-bottom: var(--rk-space-2); border-bottom: 1px solid var(--rk-border-light);">
                    1. Account Credentials & Owner Contact
                </h3>

                <div class="rk-form-group" style="margin-bottom: var(--rk-space-4);">
                    <label asp-for="FullName" class="rk-form-label"></label>
                    <input asp-for="FullName" class="rk-form-control" placeholder="e.g. Ramesh Patel" autocomplete="name" />
                    <span asp-validation-for="FullName" class="rk-form-feedback is-error"></span>
                </div>

                <div class="rk-form-group" style="margin-bottom: var(--rk-space-4);">
                    <label asp-for="Email" class="rk-form-label"></label>
                    <input asp-for="Email" type="email" class="rk-form-control" placeholder="store@example.com" autocomplete="email" />
                    <span asp-validation-for="Email" class="rk-form-feedback is-error"></span>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--rk-space-4); margin-bottom: var(--rk-space-5);">
                    <div class="rk-form-group">
                        <label asp-for="Password" class="rk-form-label"></label>
                        <input asp-for="Password" type="password" class="rk-form-control" placeholder="Min. 8 characters" autocomplete="new-password" />
                        <span asp-validation-for="Password" class="rk-form-feedback is-error"></span>
                    </div>
                    <div class="rk-form-group">
                        <label asp-for="ConfirmPassword" class="rk-form-label"></label>
                        <input asp-for="ConfirmPassword" type="password" class="rk-form-control" placeholder="Repeat password" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="rk-form-feedback is-error"></span>
                    </div>
                </div>

                <!-- Section 2: Store Information & Physical Pickup Location -->
                <h3 style="font-size: var(--rk-font-size-base); font-weight: 700; color: var(--rk-color-navy-900); margin-bottom: var(--rk-space-3); padding-bottom: var(--rk-space-2); border-bottom: 1px solid var(--rk-border-light);">
                    2. Physical Store Location & Operating Hours
                </h3>

                <div style="display: grid; grid-template-columns: 2fr 1fr; gap: var(--rk-space-4); margin-bottom: var(--rk-space-4);">
                    <div class="rk-form-group">
                        <label asp-for="ShopName" class="rk-form-label"></label>
                        <input asp-for="ShopName" class="rk-form-control" placeholder="e.g. Metro Pro Tools & Camera Hire" />
                        <span asp-validation-for="ShopName" class="rk-form-feedback is-error"></span>
                    </div>
                    <div class="rk-form-group">
                        <label asp-for="ContactPhone" class="rk-form-label"></label>
                        <input asp-for="ContactPhone" type="tel" class="rk-form-control" placeholder="+91 98765 43210" autocomplete="tel" />
                        <span asp-validation-for="ContactPhone" class="rk-form-feedback is-error"></span>
                    </div>
                </div>

                <div class="rk-form-group" style="margin-bottom: var(--rk-space-4);">
                    <label asp-for="AddressLine1" class="rk-form-label"></label>
                    <input asp-for="AddressLine1" class="rk-form-control" placeholder="e.g. Shop 12, Ground Floor, Industrial Complex, Ring Road" autocomplete="address-line1" />
                    <span asp-validation-for="AddressLine1" class="rk-form-feedback is-error"></span>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--rk-space-3); margin-bottom: var(--rk-space-4);">
                    <div class="rk-form-group">
                        <label asp-for="AddressLine2" class="rk-form-label"></label>
                        <input asp-for="AddressLine2" class="rk-form-control" placeholder="e.g. Near Industrial Estate, Phase 2" autocomplete="address-line2" />
                        <span asp-validation-for="AddressLine2" class="rk-form-feedback is-error"></span>
                    </div>
                    <div class="rk-form-group">
                        <label asp-for="Landmark" class="rk-form-label"></label>
                        <input asp-for="Landmark" class="rk-form-control" placeholder="e.g. Opp. City Railway Station" />
                        <span asp-validation-for="Landmark" class="rk-form-feedback is-error"></span>
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: 1.5fr 1fr; gap: var(--rk-space-3); margin-bottom: var(--rk-space-4);">
                    <div class="rk-form-group">
                        <label asp-for="State" class="rk-form-label"></label>
                        <select asp-for="State" class="rk-form-control" autocomplete="address-level1">
                            <option value="">-- Select State / Union Territory --</option>
                            @foreach (var s in RentKart.Core.Utilities.IndianLocations.StatesAndUnionTerritories)
                            {
                                <option value="@s">@s</option>
                            }
                        </select>
                        <span asp-validation-for="State" class="rk-form-feedback is-error"></span>
                    </div>
                    <div class="rk-form-group">
                        <label asp-for="District" class="rk-form-label"></label>
                        <input asp-for="District" class="rk-form-control" placeholder="e.g. Mumbai Suburban, Ahmedabad" />
                        <span asp-validation-for="District" class="rk-form-feedback is-error"></span>
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: 2fr 1fr; gap: var(--rk-space-3); margin-bottom: var(--rk-space-4);">
                    <div class="rk-form-group">
                        <label asp-for="City" class="rk-form-label"></label>
                        <input asp-for="City" class="rk-form-control" placeholder="e.g. Mumbai, Bengaluru, Delhi, Ahmedabad" autocomplete="address-level2" />
                        <span asp-validation-for="City" class="rk-form-feedback is-error"></span>
                    </div>
                    <div class="rk-form-group">
                        <label asp-for="PostalCode" class="rk-form-label"></label>
                        <input asp-for="PostalCode" class="rk-form-control" placeholder="e.g. 400053" maxlength="6" autocomplete="postal-code" />
                        <span asp-validation-for="PostalCode" class="rk-form-feedback is-error"></span>
                    </div>
                </div>

                <input type="hidden" asp-for="Country" value="IN" />

                <div class="rk-form-group" style="margin-bottom: var(--rk-space-4);">
                    <label asp-for="OperatingHours" class="rk-form-label"></label>
                    <input asp-for="OperatingHours" class="rk-form-control" placeholder="e.g. Mon-Sat: 09:00 - 19:00, Sun: Closed" />
                    <span asp-validation-for="OperatingHours" class="rk-form-feedback is-error"></span>
                </div>

                <div class="rk-form-group" style="margin-bottom: var(--rk-space-4);">
                    <label asp-for="RegistrationNumber" class="rk-form-label"></label>
                    <input asp-for="RegistrationNumber" class="rk-form-control" placeholder="GSTIN / Udyam / Trade License Number (Optional)" />
                    <span asp-validation-for="RegistrationNumber" class="rk-form-feedback is-error"></span>
                </div>

                <div class="rk-form-group" style="margin-bottom: var(--rk-space-5);">
                    <label asp-for="PickupInstructions" class="rk-form-label"></label>
                    <textarea asp-for="PickupInstructions" class="rk-form-control" rows="2" placeholder="e.g. Customer parking available outside gate; check in at equipment inspection counter with digital pickup code."></textarea>
                    <span asp-validation-for="PickupInstructions" class="rk-form-feedback is-error"></span>
                </div>

                <button type="submit" class="rk-btn rk-btn-teal" style="width: 100%; justify-content: center; font-size: var(--rk-font-size-base); padding: 0.75rem 1.5rem; font-weight: 700;">
                    Submit Business Registration
                </button>
            </form>

            <div style="margin-top: var(--rk-space-5); text-align: center; border-top: 1px solid var(--rk-border-light); padding-top: var(--rk-space-4); font-size: var(--rk-font-size-sm); color: var(--rk-color-slate-600);">
                Already have an account? 
                <a asp-action="Login" style="color: var(--rk-color-teal-600); font-weight: 600; text-decoration: none;">Sign in</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
