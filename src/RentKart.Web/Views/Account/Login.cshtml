@model RentKart.Web.Models.Account.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
}

<div class="rk-section" style="min-height: calc(100vh - 350px); display: flex; align-items: center;">
    <div class="rk-container" style="max-width: 480px;">
        <div class="rk-card rk-card-elevated" style="padding: var(--rk-space-6);">
            <div style="text-align: center; margin-bottom: var(--rk-space-5);">
                <div class="rk-brand-logo" style="width: 52px; height: 52px; margin: 0 auto var(--rk-space-3); border-radius: var(--rk-radius-lg);" aria-hidden="true">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
                        <polyline points="10 17 15 12 10 7"></polyline>
                        <line x1="15" y1="12" x2="3" y2="12"></line>
                    </svg>
                </div>
                <h1 style="font-size: var(--rk-font-size-2xl); font-weight: 700; color: var(--rk-navy-900); margin-bottom: var(--rk-space-1);">Welcome Back</h1>
                <p style="color: var(--rk-text-muted); font-size: var(--rk-font-size-sm);">Sign in to your RentKart account</p>
            </div>

            <form asp-action="Login" method="post" id="loginForm" novalidate>
                <input type="hidden" asp-for="ReturnUrl" />

                <div asp-validation-summary="ModelOnly" class="rk-alert rk-alert-error" role="alert" style="margin-bottom: var(--rk-space-4);"></div>

                <div class="rk-form-group" style="margin-bottom: var(--rk-space-4);">
                    <label asp-for="Email" class="rk-form-label"></label>
                    <div class="rk-input-group">
                        <span class="rk-input-addon-left" aria-hidden="true">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                                <polyline points="22,6 12,13 2,6"></polyline>
                            </svg>
                        </span>
                        <input asp-for="Email" class="rk-form-control has-addon-left" placeholder="you@example.com" autocomplete="email" autofocus required />
                    </div>
                    <span asp-validation-for="Email" class="rk-form-feedback is-error"></span>
                </div>

                <div class="rk-form-group" style="margin-bottom: var(--rk-space-4);">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--rk-space-1);">
                        <label asp-for="Password" class="rk-form-label" style="margin-bottom: 0;"></label>
                    </div>
                    <div class="rk-input-group">
                        <span class="rk-input-addon-left" aria-hidden="true">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                            </svg>
                        </span>
                        <input asp-for="Password" class="rk-form-control has-addon-left" placeholder="••••••••" autocomplete="current-password" required />
                    </div>
                    <span asp-validation-for="Password" class="rk-form-feedback is-error"></span>
                </div>

                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--rk-space-5);">
                    <label class="rk-checkbox-label" style="display: flex; align-items: center; gap: var(--rk-space-2); cursor: pointer; font-size: var(--rk-font-size-sm); color: var(--rk-text-secondary);">
                        <input asp-for="RememberMe" class="rk-form-checkbox" />
                        <span>Remember this device</span>
                    </label>
                </div>

                <button type="submit" class="rk-btn rk-btn-primary" style="width: 100%; justify-content: center; font-size: var(--rk-font-size-base); padding: 0.75rem 1.5rem;">
                    Sign In
                </button>
            </form>

            <div style="margin-top: var(--rk-space-5); text-align: center; border-top: 1px solid var(--rk-border-light); padding-top: var(--rk-space-4); font-size: var(--rk-font-size-sm); color: var(--rk-text-secondary);">
                Don't have an account yet? 
                <a asp-action="Register" style="color: var(--rk-teal-600); font-weight: 600; text-decoration: none;">Create an account</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
