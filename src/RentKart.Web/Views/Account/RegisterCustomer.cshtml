@model RentKart.Web.Models.Account.RegisterCustomerViewModel
@{
    ViewData["Title"] = "Customer Registration";
}

<div class="rk-section" style="min-height: calc(100vh - 350px); display: flex; align-items: center;">
    <div class="rk-container" style="max-width: 520px;">
        <div class="rk-card rk-card-elevated" style="padding: var(--rk-space-6);">
            <div style="text-align: center; margin-bottom: var(--rk-space-5);">
                <div class="rk-brand-logo" style="width: 52px; height: 52px; margin: 0 auto var(--rk-space-3); border-radius: var(--rk-radius-lg);" aria-hidden="true">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                        <circle cx="8.5" cy="7" r="4"></circle>
                        <line x1="20" y1="8" x2="20" y2="14"></line>
                        <line x1="23" y1="11" x2="17" y2="11"></line>
                    </svg>
                </div>
                <h1 style="font-size: var(--rk-font-size-2xl); font-weight: 700; color: var(--rk-navy-900); margin-bottom: var(--rk-space-1);">Create Customer Account</h1>
                <p style="color: var(--rk-text-muted); font-size: var(--rk-font-size-sm);">Rent equipment from local businesses with confidence</p>
            </div>

            <form asp-action="RegisterCustomer" method="post" id="customerRegisterForm" novalidate>
                <div asp-validation-summary="ModelOnly" class="rk-alert rk-alert-error" role="alert" style="margin-bottom: var(--rk-space-4);"></div>

                <div class="rk-form-group" style="margin-bottom: var(--rk-space-4);">
                    <label asp-for="FullName" class="rk-form-label"></label>
                    <input asp-for="FullName" class="rk-form-control" placeholder="e.g. John Doe" autocomplete="name" autofocus required />
                    <span asp-validation-for="FullName" class="rk-form-feedback is-error"></span>
                </div>

                <div class="rk-form-group" style="margin-bottom: var(--rk-space-4);">
                    <label asp-for="Email" class="rk-form-label"></label>
                    <input asp-for="Email" class="rk-form-control" placeholder="john.doe@example.com" autocomplete="email" required />
                    <span asp-validation-for="Email" class="rk-form-feedback is-error"></span>
                </div>

                <div class="rk-form-group" style="margin-bottom: var(--rk-space-4);">
                    <label asp-for="PhoneNumber" class="rk-form-label"></label>
                    <input asp-for="PhoneNumber" class="rk-form-control" placeholder="+1 (555) 000-0000" autocomplete="tel" required />
                    <span asp-validation-for="PhoneNumber" class="rk-form-feedback is-error"></span>
                </div>

                <div class="rk-form-group" style="margin-bottom: var(--rk-space-4);">
                    <label asp-for="Password" class="rk-form-label"></label>
                    <input asp-for="Password" class="rk-form-control" placeholder="At least 8 characters, with letters, digits, and symbols" autocomplete="new-password" required />
                    <span asp-validation-for="Password" class="rk-form-feedback is-error"></span>
                </div>

                <div class="rk-form-group" style="margin-bottom: var(--rk-space-5);">
                    <label asp-for="ConfirmPassword" class="rk-form-label"></label>
                    <input asp-for="ConfirmPassword" class="rk-form-control" placeholder="Repeat your password" autocomplete="new-password" required />
                    <span asp-validation-for="ConfirmPassword" class="rk-form-feedback is-error"></span>
                </div>

                <button type="submit" class="rk-btn rk-btn-primary" style="width: 100%; justify-content: center; font-size: var(--rk-font-size-base); padding: 0.75rem 1.5rem;">
                    Complete Registration
                </button>
            </form>

            <div style="margin-top: var(--rk-space-5); text-align: center; border-top: 1px solid var(--rk-border-light); padding-top: var(--rk-space-4); font-size: var(--rk-font-size-sm); color: var(--rk-text-secondary);">
                Already have an account? 
                <a asp-action="Login" style="color: var(--rk-teal-600); font-weight: 600; text-decoration: none;">Sign in</a>
                &bull;
                <a asp-action="RegisterBusiness" style="color: var(--rk-teal-600); font-weight: 600; text-decoration: none;">Register as business</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
