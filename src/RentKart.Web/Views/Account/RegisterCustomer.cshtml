@model RentKart.Web.Models.Account.RegisterCustomerViewModel
@{
    ViewData["Title"] = "Customer Registration";
}

<div class="rk-section" style="min-height: calc(100vh - 350px); display: flex; align-items: center; padding: var(--rk-space-8) 0;">
    <div class="rk-container" style="max-width: 520px;">
        <div class="rk-card rk-card-elevated" style="padding: var(--rk-space-6);">
            <div style="text-align: center; margin-bottom: var(--rk-space-5);">
                <div class="rk-brand-logo" style="width: 54px; height: 54px; margin: 0 auto var(--rk-space-3); border-radius: var(--rk-radius-lg); background: var(--rk-color-navy-900); color: #ffffff; display: flex; align-items: center; justify-content: center;" aria-hidden="true">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                        <circle cx="8.5" cy="7" r="4"></circle>
                        <line x1="20" y1="8" x2="20" y2="14"></line>
                        <line x1="23" y1="11" x2="17" y2="11"></line>
                    </svg>
                </div>
                <h1 style="font-size: var(--rk-font-size-2xl); font-weight: 700; color: var(--rk-color-navy-900); margin-bottom: var(--rk-space-1);">Create Customer Account</h1>
                <p style="color: var(--rk-color-slate-500); font-size: var(--rk-font-size-sm); margin-bottom: 0;">
                    Rent tools, cameras, and equipment from verified local rental shops across India
                </p>
            </div>

            <form asp-action="RegisterCustomer" method="post" id="customerRegisterForm" novalidate>
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="rk-alert rk-alert-error" role="alert" style="margin-bottom: var(--rk-space-4);"></div>

                <div class="rk-form-group" style="margin-bottom: var(--rk-space-4);">
                    <label asp-for="FullName" class="rk-form-label"></label>
                    <input asp-for="FullName" class="rk-form-control" placeholder="e.g. Smit Bhalani" autocomplete="name" autofocus />
                    <span asp-validation-for="FullName" class="rk-form-feedback is-error"></span>
                </div>

                <div class="rk-form-group" style="margin-bottom: var(--rk-space-4);">
                    <label asp-for="Email" class="rk-form-label"></label>
                    <input asp-for="Email" type="email" class="rk-form-control" placeholder="name@example.com" autocomplete="email" />
                    <span asp-validation-for="Email" class="rk-form-feedback is-error"></span>
                </div>

                <div class="rk-form-group" style="margin-bottom: var(--rk-space-4);">
                    <label asp-for="PhoneNumber" class="rk-form-label"></label>
                    <input asp-for="PhoneNumber" type="tel" class="rk-form-control" placeholder="+91 98765 43210 or 9876543210" autocomplete="tel" />
                    <span class="rk-form-hint" style="font-size: var(--rk-font-size-xs); color: var(--rk-color-slate-500); display: block; margin-top: 4px;">
                        10-digit Indian mobile number for store pickup verification SMS and booking updates.
                    </span>
                    <span asp-validation-for="PhoneNumber" class="rk-form-feedback is-error"></span>
                </div>

                <div class="rk-form-group" style="margin-bottom: var(--rk-space-4);">
                    <label asp-for="Password" class="rk-form-label"></label>
                    <input asp-for="Password" type="password" class="rk-form-control" placeholder="Min 8 characters (Upper, lower, digit & special)" autocomplete="new-password" />
                    <span class="rk-form-hint" style="font-size: var(--rk-font-size-xs); color: var(--rk-color-slate-500); display: block; margin-top: 4px;">
                        Must contain at least 8 characters with 1 uppercase, 1 lowercase, 1 digit, and 1 special symbol.
                    </span>
                    <span asp-validation-for="Password" class="rk-form-feedback is-error"></span>
                </div>

                <div class="rk-form-group" style="margin-bottom: var(--rk-space-5);">
                    <label asp-for="ConfirmPassword" class="rk-form-label"></label>
                    <input asp-for="ConfirmPassword" type="password" class="rk-form-control" placeholder="Repeat your password" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="rk-form-feedback is-error"></span>
                </div>

                <button type="submit" class="rk-btn rk-btn-teal" style="width: 100%; justify-content: center; font-size: var(--rk-font-size-base); padding: 0.75rem 1.5rem; font-weight: 700;">
                    Complete Registration
                </button>
            </form>

            <div style="margin-top: var(--rk-space-5); text-align: center; border-top: 1px solid var(--rk-border-light); padding-top: var(--rk-space-4); font-size: var(--rk-font-size-sm); color: var(--rk-color-slate-600);">
                Already have an account? 
                <a asp-action="Login" style="color: var(--rk-color-teal-600); font-weight: 600; text-decoration: none;">Sign in</a>
                &bull;
                <a asp-action="RegisterBusiness" style="color: var(--rk-color-teal-600); font-weight: 600; text-decoration: none;">Register as rental shop</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
