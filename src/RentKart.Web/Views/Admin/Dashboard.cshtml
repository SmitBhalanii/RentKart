@using RentKart.Core.Enums
@model RentKart.Web.Models.Admin.AdminDashboardViewModel
@{
    ViewData["Title"] = "Platform Administration - Overview";
}

<div class="rk-section" style="padding-top: var(--rk-space-6); padding-bottom: var(--rk-space-8);">
    <div class="rk-container">
        <!-- Admin Title Banner -->
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: var(--rk-space-4); margin-bottom: var(--rk-space-4);">
            <div>
                <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 2px;">
                    <h1 style="font-size: var(--rk-font-size-3xl); font-weight: 800; color: var(--rk-navy-900); margin-bottom: 0;">Platform Administration</h1>
                    <span class="rk-badge rk-badge-info" style="background: var(--rk-navy-900); color: #ffffff;">Admin Privileges</span>
                </div>
                <p style="color: var(--rk-text-muted); font-size: var(--rk-font-size-sm); margin-bottom: 0;">
                    Real-time database metrics, store moderation, catalog oversight, and audit logs
                </p>
            </div>
        </div>

        <!-- Admin Sub-Navigation -->
        <partial name="_AdminNav" />

        <!-- Top Metrics Cards -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: var(--rk-space-4); margin-bottom: var(--rk-space-6);">
            <!-- Users -->
            <div class="rk-card" style="padding: var(--rk-space-4); border-top: 3px solid var(--rk-teal-500);">
                <div style="font-size: var(--rk-font-size-xs); font-weight: 600; color: var(--rk-text-muted); text-transform: uppercase;">Total Users & Customers</div>
                <div style="font-size: var(--rk-font-size-2xl); font-weight: 800; color: var(--rk-navy-900); margin-top: 0.25rem;">
                    @Model.Metrics.TotalUsersCount
                </div>
                <div style="font-size: var(--rk-font-size-xs); color: var(--rk-text-muted); margin-top: 0.25rem;">
                    <strong>@Model.Metrics.TotalCustomersCount</strong> Customers &bull; <strong>@Model.Metrics.TotalBusinessesCount</strong> Stores
                </div>
            </div>

            <!-- Stores by Status -->
            <div class="rk-card" style="padding: var(--rk-space-4); border-top: 3px solid @(Model.Metrics.PendingBusinessesCount > 0 ? "var(--rk-warning)" : "var(--rk-success)");">
                <div style="font-size: var(--rk-font-size-xs); font-weight: 600; color: var(--rk-text-muted); text-transform: uppercase;">Store Status</div>
                <div style="font-size: var(--rk-font-size-2xl); font-weight: 800; color: @(Model.Metrics.PendingBusinessesCount > 0 ? "var(--rk-warning)" : "var(--rk-navy-900)"); margin-top: 0.25rem;">
                    @Model.Metrics.PendingBusinessesCount <span style="font-size: var(--rk-font-size-sm); font-weight: 500; color: var(--rk-text-muted);">Pending</span>
                </div>
                <div style="font-size: var(--rk-font-size-xs); color: var(--rk-text-muted); margin-top: 0.25rem;">
                    <strong>@Model.Metrics.ApprovedBusinessesCount</strong> Active &bull; <strong>@Model.Metrics.SuspendedBusinessesCount</strong> Suspended
                </div>
            </div>

            <!-- Equipment Listings -->
            <div class="rk-card" style="padding: var(--rk-space-4); border-top: 3px solid var(--rk-teal-600);">
                <div style="font-size: var(--rk-font-size-xs); font-weight: 600; color: var(--rk-text-muted); text-transform: uppercase;">Equipment Listings</div>
                <div style="font-size: var(--rk-font-size-2xl); font-weight: 800; color: var(--rk-navy-900); margin-top: 0.25rem;">
                    @Model.Metrics.TotalEquipmentCount
                </div>
                <div style="font-size: var(--rk-font-size-xs); color: var(--rk-text-muted); margin-top: 0.25rem;">
                    <strong>@Model.Metrics.ActiveEquipmentCount</strong> Active &bull; <strong>@Model.Metrics.MaintenanceEquipmentCount</strong> in Maintenance
                </div>
            </div>

            <!-- Bookings -->
            <div class="rk-card" style="padding: var(--rk-space-4); border-top: 3px solid #3b82f6;">
                <div style="font-size: var(--rk-font-size-xs); font-weight: 600; color: var(--rk-text-muted); text-transform: uppercase;">Platform Bookings</div>
                <div style="font-size: var(--rk-font-size-2xl); font-weight: 800; color: var(--rk-navy-900); margin-top: 0.25rem;">
                    @Model.Metrics.TotalBookingsCount
                </div>
                <div style="font-size: var(--rk-font-size-xs); color: var(--rk-text-muted); margin-top: 0.25rem;">
                    <strong>@Model.Metrics.ActiveBookingsCount</strong> Active &bull; <strong>@Model.Metrics.CompletedBookingsCount</strong> Completed
                </div>
            </div>

            <!-- Platform Turnover -->
            <div class="rk-card" style="padding: var(--rk-space-4); border-top: 3px solid var(--rk-teal-700);">
                <div style="font-size: var(--rk-font-size-xs); font-weight: 600; color: var(--rk-text-muted); text-transform: uppercase;">Platform Turnover</div>
                <div style="font-size: var(--rk-font-size-2xl); font-weight: 800; color: var(--rk-teal-700); margin-top: 0.25rem;">
                    $@Model.Metrics.TotalPlatformTurnover.ToString("F2")
                </div>
                <div style="font-size: var(--rk-font-size-xs); color: var(--rk-text-muted); margin-top: 0.25rem;">
                    Rental: $@Model.Metrics.TotalRentalFeeVolume.ToString("F2") &bull; Deposit: $@Model.Metrics.TotalSecurityDepositVolume.ToString("F2")
                </div>
            </div>

            <!-- Reviews & Rating -->
            <div class="rk-card" style="padding: var(--rk-space-4); border-top: 3px solid #f59e0b;">
                <div style="font-size: var(--rk-font-size-xs); font-weight: 600; color: var(--rk-text-muted); text-transform: uppercase;">Customer Reviews</div>
                <div style="font-size: var(--rk-font-size-2xl); font-weight: 800; color: var(--rk-navy-900); margin-top: 0.25rem;">
                    @Model.Metrics.TotalReviewsCount <span style="font-size: var(--rk-font-size-sm); color: #f59e0b;">(★ @Model.Metrics.AverageRating.ToString("F1"))</span>
                </div>
                <div style="font-size: var(--rk-font-size-xs); color: var(--rk-text-muted); margin-top: 0.25rem;">
                    <strong>@Model.Metrics.VisibleReviewsCount</strong> Published &bull; <strong>@Model.Metrics.HiddenReviewsCount</strong> Hidden
                </div>
            </div>
        </div>

        <!-- Action Quick Links Grid -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: var(--rk-space-4); margin-bottom: var(--rk-space-6);">
            <a asp-action="Customers" class="rk-card" style="text-decoration: none; padding: var(--rk-space-4); border: 1px solid var(--rk-border-light); display: flex; align-items: center; justify-content: space-between; transition: all 0.2s ease;">
                <div>
                    <div style="font-weight: 700; color: var(--rk-navy-900);">Customer Directory</div>
                    <div style="font-size: var(--rk-font-size-xs); color: var(--rk-text-muted);">Manage accounts, view rentals, toggle lockouts</div>
                </div>
                <span style="color: var(--rk-teal-600); font-weight: 700;">&rarr;</span>
            </a>

            <a asp-action="Categories" class="rk-card" style="text-decoration: none; padding: var(--rk-space-4); border: 1px solid var(--rk-border-light); display: flex; align-items: center; justify-content: space-between; transition: all 0.2s ease;">
                <div>
                    <div style="font-weight: 700; color: var(--rk-navy-900);">Category Taxonomy</div>
                    <div style="font-size: var(--rk-font-size-xs); color: var(--rk-text-muted);">Create, edit, organize rental categories</div>
                </div>
                <span style="color: var(--rk-teal-600); font-weight: 700;">&rarr;</span>
            </a>

            <a asp-action="Equipment" class="rk-card" style="text-decoration: none; padding: var(--rk-space-4); border: 1px solid var(--rk-border-light); display: flex; align-items: center; justify-content: space-between; transition: all 0.2s ease;">
                <div>
                    <div style="font-weight: 700; color: var(--rk-navy-900);">Equipment Moderation</div>
                    <div style="font-size: var(--rk-font-size-xs); color: var(--rk-text-muted);">Inspect catalog listings across all stores</div>
                </div>
                <span style="color: var(--rk-teal-600); font-weight: 700;">&rarr;</span>
            </a>

            <a asp-action="Reviews" class="rk-card" style="text-decoration: none; padding: var(--rk-space-4); border: 1px solid var(--rk-border-light); display: flex; align-items: center; justify-content: space-between; transition: all 0.2s ease;">
                <div>
                    <div style="font-weight: 700; color: var(--rk-navy-900);">Review Moderation</div>
                    <div style="font-size: var(--rk-font-size-xs); color: var(--rk-text-muted);">Moderate customer feedback & ratings</div>
                </div>
                <span style="color: var(--rk-teal-600); font-weight: 700;">&rarr;</span>
            </a>

            <a asp-action="DamageReports" class="rk-card" style="text-decoration: none; padding: var(--rk-space-4); border: 1px solid var(--rk-border-light); display: flex; align-items: center; justify-content: space-between; transition: all 0.2s ease;">
                <div>
                    <div style="font-weight: 700; color: var(--rk-navy-900);">Damage & Maintenance</div>
                    <div style="font-size: var(--rk-font-size-xs); color: var(--rk-text-muted);">@Model.Metrics.ActiveDamageReportsCount unresolved return damage incident(s)</div>
                </div>
                <span style="color: var(--rk-teal-600); font-weight: 700;">&rarr;</span>
            </a>

            <a asp-action="AuditLogs" class="rk-card" style="text-decoration: none; padding: var(--rk-space-4); border: 1px solid var(--rk-border-light); display: flex; align-items: center; justify-content: space-between; transition: all 0.2s ease;">
                <div>
                    <div style="font-weight: 700; color: var(--rk-navy-900);">Audit Trail</div>
                    <div style="font-size: var(--rk-font-size-xs); color: var(--rk-text-muted);">Full immutable administrative event log</div>
                </div>
                <span style="color: var(--rk-teal-600); font-weight: 700;">&rarr;</span>
            </a>
        </div>

        <!-- Pending Approval Queue -->
        <div class="rk-card rk-card-elevated" style="padding: var(--rk-space-5); margin-bottom: var(--rk-space-6);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--rk-space-4);">
                <div style="display: flex; align-items: center; gap: 0.5rem;">
                    <h2 style="font-size: var(--rk-font-size-lg); font-weight: 700; color: var(--rk-navy-900); margin-bottom: 0;">Pending Store Verifications</h2>
                    <span class="rk-badge rk-badge-warning">@Model.PendingBusinessesCount Awaiting</span>
                </div>
                <a asp-action="Businesses" style="font-size: var(--rk-font-size-xs); color: var(--rk-teal-600); text-decoration: none; font-weight: 600;">
                    View All Stores &rarr;
                </a>
            </div>

            @if (Model.PendingBusinesses.Any())
            {
                <div style="overflow-x: auto;">
                    <table class="rk-table" style="width: 100%;">
                        <thead>
                            <tr>
                                <th>Store & Owner</th>
                                <th>Location</th>
                                <th>Contact & Hours</th>
                                <th>Registered</th>
                                <th style="text-align: right;">Administrative Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var biz in Model.PendingBusinesses)
                            {
                                <tr>
                                    <td>
                                        <div style="font-weight: 700; color: var(--rk-navy-900);">@biz.ShopName</div>
                                        <div style="font-size: var(--rk-font-size-xs); color: var(--rk-text-muted);">
                                            Owner: @biz.OwnerName (@biz.OwnerEmail)
                                        </div>
                                    </td>
                                    <td>
                                        <div>@biz.City, @biz.State</div>
                                    </td>
                                    <td>
                                        <div>@biz.ContactPhone</div>
                                        <div style="font-size: var(--rk-font-size-xs); color: var(--rk-text-muted);">@biz.OperatingHours</div>
                                    </td>
                                    <td>
                                        <span style="font-size: var(--rk-font-size-xs); color: var(--rk-text-secondary);">@biz.CreatedAtUtc.ToString("dd MMM yyyy, HH:mm") UTC</span>
                                    </td>
                                    <td style="text-align: right;">
                                        <div style="display: inline-flex; gap: 0.5rem; justify-content: flex-end;">
                                            <form asp-action="ApproveBusiness" method="post" style="display: inline;">
                                                <input type="hidden" name="id" value="@biz.Id" />
                                                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                                <button type="submit" class="rk-btn rk-btn-sm rk-btn-teal" title="Approve store so listings can go live">
                                                    Approve
                                                </button>
                                            </form>
                                            <form asp-action="RejectBusiness" method="post" style="display: inline;">
                                                <input type="hidden" name="id" value="@biz.Id" />
                                                <input type="hidden" name="reason" value="Failed verification criteria" />
                                                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                                <button type="submit" class="rk-btn rk-btn-sm rk-btn-outline" style="color: var(--rk-error); border-color: var(--rk-error);" title="Reject store registration">
                                                    Reject
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div style="text-align: center; padding: var(--rk-space-6); background: var(--rk-neutral-50); border-radius: var(--rk-radius-md);">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--rk-success)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 0.5rem;">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                    <div style="font-weight: 600; color: var(--rk-navy-900);">Verification queue is clear</div>
                    <div style="font-size: var(--rk-font-size-xs); color: var(--rk-text-muted);">All registered business applications have been reviewed.</div>
                </div>
            }
        </div>
    </div>
</div>
