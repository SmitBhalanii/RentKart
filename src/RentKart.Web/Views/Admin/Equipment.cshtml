@model RentKart.Web.Models.Admin.AdminEquipmentViewModel
@{
    ViewData["Title"] = "Equipment Moderation - Admin";
}

<div class="rk-section" style="padding-top: var(--rk-space-6); padding-bottom: var(--rk-space-8);">
    <div class="rk-container">
        <!-- Title Banner -->
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: var(--rk-space-4); margin-bottom: var(--rk-space-4);">
            <div>
                <h1 style="font-size: var(--rk-font-size-2xl); font-weight: 800; color: var(--rk-navy-900); margin-bottom: 2px;">
                    Equipment Moderation & Oversight
                </h1>
                <p style="color: var(--rk-text-muted); font-size: var(--rk-font-size-sm); margin-bottom: 0;">
                    Monitor all merchant equipment listings, enforce platform policies, and suspend non-compliant items
                </p>
            </div>
        </div>

        <partial name="_AdminNav" />

        <!-- Search & Filter Controls -->
        <div class="rk-card" style="padding: var(--rk-space-4); margin-bottom: var(--rk-space-5);">
            <form method="get" asp-action="Equipment" style="display: flex; gap: var(--rk-space-3); flex-wrap: wrap; align-items: center;">
                <input type="text" name="search" value="@Model.Search" placeholder="Search by title, merchant store, or category..." class="rk-form-control" style="flex: 1; min-width: 220px;" />

                <select name="categoryId" class="rk-form-control" style="width: auto; min-width: 160px;">
                    <option value="">All Categories</option>
                    @foreach (var cat in Model.Categories)
                    {
                        <option value="@cat.Id" selected="@(Model.CategoryId == cat.Id)">@cat.Name</option>
                    }
                </select>

                <select name="isActive" class="rk-form-control" style="width: auto; min-width: 140px;">
                    <option value="">All Statuses</option>
                    <option value="true" selected="@(Model.IsActive == true)">Active Only</option>
                    <option value="false" selected="@(Model.IsActive == false)">Suspended / Inactive</option>
                </select>

                <button type="submit" class="rk-btn rk-btn-primary">
                    Filter
                </button>
                <a asp-action="Equipment" class="rk-btn rk-btn-outline">
                    Reset
                </a>
            </form>
        </div>

        <!-- Equipment Table Card -->
        <div class="rk-card rk-card-elevated" style="padding: var(--rk-space-5);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--rk-space-4);">
                <div style="font-weight: 700; color: var(--rk-navy-900); font-size: var(--rk-font-size-base);">
                    Equipment Listings (@Model.TotalCount)
                </div>
            </div>

            @if (Model.Equipment.Any())
            {
                <div style="overflow-x: auto;">
                    <table class="rk-table" style="width: 100%;">
                        <thead>
                            <tr>
                                <th>Equipment</th>
                                <th>Merchant Store</th>
                                <th>Category</th>
                                <th style="text-align: right;">Daily Rate</th>
                                <th style="text-align: center;">Total Units</th>
                                <th style="text-align: center;">Status</th>
                                <th style="text-align: right;">Moderation</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var eq in Model.Equipment)
                            {
                                <tr>
                                    <td>
                                        <div style="display: flex; gap: var(--rk-space-3); align-items: center;">
                                            @if (!string.IsNullOrEmpty(eq.PrimaryImageUrl))
                                            {
                                                <img src="@eq.PrimaryImageUrl" alt="@eq.Title" style="width: 44px; height: 44px; object-fit: cover; border-radius: var(--rk-radius-sm);" />
                                            }
                                            else
                                            {
                                                <div style="width: 44px; height: 44px; background: var(--rk-neutral-200); border-radius: var(--rk-radius-sm); display: flex; align-items: center; justify-content: center; color: var(--rk-text-muted); font-size: 10px;">
                                                    No Pic
                                                </div>
                                            }
                                            <div>
                                                <div style="font-weight: 700; color: var(--rk-navy-900);">
                                                    <a asp-controller="Catalog" asp-action="Details" asp-route-id="@eq.Id" target="_blank" style="color: inherit; text-decoration: none;">
                                                        @eq.Title &nearr;
                                                    </a>
                                                </div>
                                                <div style="font-size: var(--rk-font-size-xs); color: var(--rk-text-muted);">
                                                    ID: #@eq.Id &bull; Condition: @eq.Condition
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div style="font-weight: 600; color: var(--rk-navy-900);">
                                            @eq.ShopName
                                        </div>
                                    </td>
                                    <td>
                                        <span class="rk-badge rk-badge-info">@eq.CategoryName</span>
                                    </td>
                                    <td style="text-align: right; font-weight: 700; color: var(--rk-navy-900);">
                                        $@eq.DailyRentalRate.ToString("F2")
                                    </td>
                                    <td style="text-align: center;">
                                        @eq.TotalQuantity
                                    </td>
                                    <td style="text-align: center;">
                                        @if (eq.IsActive && eq.Status == RentKart.Core.Enums.EquipmentStatus.Active)
                                        {
                                            <span class="rk-badge rk-badge-success">Live</span>
                                        }
                                        else
                                        {
                                            <span class="rk-badge rk-badge-error">Suspended / Inactive</span>
                                        }
                                    </td>
                                    <td style="text-align: right;">
                                        <form asp-action="ToggleEquipmentStatus" method="post" style="display: inline;" onsubmit="return confirm('Are you sure you want to @(eq.IsActive ? "suspend" : "activate") this listing?');">
                                            <input type="hidden" name="id" value="@eq.Id" />
                                            <input type="hidden" name="isActive" value="@(eq.IsActive ? "false" : "true")" />
                                            <input type="hidden" name="reason" value="Admin moderation action" />
                                            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                            <button type="submit" class="rk-btn rk-btn-sm @(eq.IsActive ? "rk-btn-outline" : "rk-btn-teal")" style="@(eq.IsActive ? "color: var(--rk-error); border-color: var(--rk-error);" : "")">
                                                @(eq.IsActive ? "Suspend" : "Activate")
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.TotalPages > 1)
                {
                    <div style="display: flex; justify-content: center; gap: 0.5rem; margin-top: var(--rk-space-5);">
                        @for (int p = 1; p <= Model.TotalPages; p++)
                        {
                            <a asp-action="Equipment" asp-route-page="@p" asp-route-search="@Model.Search" asp-route-categoryId="@Model.CategoryId" asp-route-isActive="@Model.IsActive" class="rk-btn rk-btn-sm @(p == Model.Page ? "rk-btn-primary" : "rk-btn-outline")">
                                @p
                            </a>
                        }
                    </div>
                }
            }
            else
            {
                <div style="text-align: center; padding: var(--rk-space-6); color: var(--rk-text-muted);">
                    No equipment listings found matching your filters.
                </div>
            }
        </div>
    </div>
</div>
