                            <td><span class="rk-badge rk-badge-confirmed"><span class="rk-badge-dot"></span>Confirmed</span></td>
                            <td style="text-align: right;">
                                <button type="button" class="rk-btn rk-btn-secondary rk-btn-sm">View Voucher</button>
                            </td>
                        </tr>
                        <tr>
                            <td><strong>#RK-10082-B</strong></td>
                            <td>Metro Tool Supply</td>
                            <td>DeWalt 20V Combo &bull; 1 Unit</td>
                            <td>Oct 20, 2026 &ndash; Oct 22, 2026</td>
                            <td>$80.00</td>
                            <td><span class="rk-badge rk-badge-pending"><span class="rk-badge-dot"></span>Awaiting Pickup</span></td>
                            <td style="text-align: right;">
                                <button type="button" class="rk-btn rk-btn-teal rk-btn-sm">Pickup Code</button>
                            </td>
                        </tr>
                        <tr>
                            <td><strong>#RK-10079-A</strong></td>
                            <td>Vision Event Hub</td>
                            <td>Epson Pro Cinema 4K &bull; 2 Units</td>
                            <td>Oct 10, 2026 &ndash; Oct 12, 2026</td>
                            <td>$400.00</td>
                            <td><span class="rk-badge rk-badge-completed"><span class="rk-badge-dot"></span>Completed</span></td>
                            <td style="text-align: right;">
                                <button type="button" class="rk-btn rk-btn-outline rk-btn-sm">Write Review</button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Shared Alerts & Feedback States -->
        <div style="margin-top: var(--rk-space-6);">
            <h3 style="font-size: var(--rk-font-size-lg); margin-bottom: var(--rk-space-3);">Alert & Notification Styles</h3>
            <div class="rk-alert rk-alert-success">
                <svg class="rk-alert-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                    <polyline points="22 4 12 14.01 9 11.01"></polyline>
                </svg>
                <div class="rk-alert-content">
                    <strong>Booking Group Accepted:</strong> Apex Media Rentals accepted your reservation for Oct 20. Your digital pickup voucher is ready.
                </div>
            </div>

            <div class="rk-alert rk-alert-warning">
                <svg class="rk-alert-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path>
                    <line x1="12" y1="9" x2="12" y2="13"></line>
                    <line x1="12" y1="17" x2="12.01" y2="17"></line>
                </svg>
                <div class="rk-alert-content">
                    <strong>Pickup Reminder:</strong> Please bring government photo ID matching your profile name to the storefront.
                </div>
            </div>

            <div class="rk-alert rk-alert-danger">
                <svg class="rk-alert-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                <div class="rk-alert-content">
                    <strong>Reservation Conflict:</strong> The selected dates are in maintenance downtime. Please pick alternative dates.
                </div>
            </div>
        </div>

        <!-- Empty & Loading States Demonstration -->
        <div class="rk-grid-2" style="margin-top: var(--rk-space-6);">
            <div>
                <h3 style="font-size: var(--rk-font-size-lg); margin-bottom: var(--rk-space-3);">Empty State (.rk-empty-state)</h3>
                <div class="rk-empty-state">
                    <div class="rk-empty-state-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                    </div>
                    <div class="rk-empty-state-title">No Equipment Found</div>
                    <p class="rk-empty-state-text">We couldn't find any listings matching your search filters in this district. Try broadening your dates or categories.</p>
                    <button type="button" class="rk-btn rk-btn-secondary rk-btn-sm">Reset Search Filters</button>
                </div>
            </div>

            <div>
                <h3 style="font-size: var(--rk-font-size-lg); margin-bottom: var(--rk-space-3);">Loading States (.rk-skeleton & .rk-spinner)</h3>
                <div class="rk-card" style="padding: var(--rk-space-6); display: flex; flex-direction: column; gap: var(--rk-space-4);">
                    <div style="display: flex; align-items: center; gap: var(--rk-space-3);">
                        <div class="rk-spinner" aria-label="Loading indicator"></div>
                        <span style="font-size: var(--rk-font-size-sm); color: var(--rk-text-muted);">Fetching store availability calendar...</span>
                    </div>
                    <div class="rk-skeleton" style="height: 18px; width: 60%;"></div>
                    <div class="rk-skeleton" style="height: 14px; width: 90%;"></div>
                    <div class="rk-skeleton" style="height: 14px; width: 75%;"></div>
                    <div class="rk-skeleton" style="height: 38px; width: 40%; margin-top: var(--rk-space-2);"></div>
                </div>
            </div>
        </div>
    </div>
</section>

