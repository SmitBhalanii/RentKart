@model RentKart.Web.Models.HomeIndexViewModel
@{
    ViewData["Title"] = "Rent Anything You Need — Verified Equipment Marketplace";
}

<!-- Hero Section -->
<section class="rk-hero" aria-label="Hero Introduction">
    <div class="rk-container">
        <div class="rk-hero-content">
            <div class="rk-hero-badge">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                <span>India's Multi-Vendor Equipment Marketplace &bull; Verified Store Handover</span>
            </div>

            <h1 class="rk-hero-title">
                Rent Professional Equipment — <span>From Verified Local Stores</span>
            </h1>

            <p class="rk-hero-subtitle">
                Access cinema cameras, power tools, generators, AV equipment, and machinery in Mumbai, Bengaluru, Delhi, and across India without heavy capital costs. Pick up directly from authorized neighborhood businesses.
            </p>

            <!-- Live Search Form -->
            <form class="rk-hero-search" method="get" asp-controller="Catalog" asp-action="Index" role="search" aria-label="Search rental inventory">
                <div class="rk-hero-search-input">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--rk-teal-600)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    <input type="text" name="Search" placeholder="Search cameras, drills, generators, PA speakers..." aria-label="Equipment search term" />
                </div>
                <div class="rk-hero-search-divider"></div>
                <div class="rk-hero-search-select">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--rk-neutral-400)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                        <circle cx="12" cy="10" r="3"></circle>
                    </svg>
                    <select name="City" aria-label="Select rental store location">
                        <option value="">All Indian Cities</option>
                        @if (Model?.AvailableCities != null)
                        {
                            foreach (var city in Model.AvailableCities)
                            {
                                <option value="@city">@city Stores</option>
                            }
                        }
                    </select>
                </div>
                <button type="submit" class="rk-btn rk-btn-teal rk-btn-lg" style="width: 100%; justify-content: center;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    <span>Search Gear</span>
                </button>
            </form>
        </div>
    </div>
</section>

<!-- Category Quick Filter Chips -->
<section class="rk-container" style="padding-top: var(--rk-space-6); padding-bottom: var(--rk-space-4);" id="categories" aria-label="Popular Categories">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--rk-space-3);">
        <h2 style="font-size: var(--rk-font-size-base); font-weight: 700; color: var(--rk-navy-900); margin-bottom: 0;">Browse by Category</h2>
        <a asp-controller="Catalog" asp-action="Index" style="font-size: var(--rk-font-size-xs); font-weight: 600; color: var(--rk-teal-600); text-decoration: none;">View All Categories &rarr;</a>
    </div>
    <div class="rk-category-chips">
        <a asp-controller="Catalog" asp-action="Index" class="rk-chip is-active">All Equipment</a>
        @if (Model?.Categories != null)
        {
            foreach (var cat in Model.Categories)
            {
                <a asp-controller="Catalog" asp-action="Index" asp-route-categorySlug="@cat.Slug" class="rk-chip">
                    @cat.Name (@cat.ActiveListingsCount)
                </a>
            }
        }
    </div>
</section>

<!-- How It Works Section -->
<section class="rk-container" style="padding-top: var(--rk-space-8); padding-bottom: var(--rk-space-10);" id="how-it-works" aria-labelledby="how-it-works-title">
    <div class="rk-section-header">
        <div>
            <h2 id="how-it-works-title" class="rk-section-title">How RentKart Works</h2>
            <p class="rk-section-subtitle">A seamless local rental experience connecting you with trusted physical stores across India.</p>
        </div>
        <span class="rk-badge rk-badge-teal">Simple 4-Step Process</span>
    </div>

    <div class="rk-grid-4">
        <div class="rk-step-card">
            <div class="rk-step-number">01</div>
            <h3 style="font-size: var(--rk-font-size-md); margin-bottom: var(--rk-space-2);">1. Discover & Check Dates</h3>
            <p style="font-size: var(--rk-font-size-sm); color: var(--rk-text-secondary);">Browse live inventory from verified local rental shops and check instant date availability.</p>
        </div>

        <div class="rk-step-card">
            <div class="rk-step-number">02</div>
            <h3 style="font-size: var(--rk-font-size-md); margin-bottom: var(--rk-space-2);">2. Multi-Store Booking</h3>
            <p style="font-size: var(--rk-font-size-sm); color: var(--rk-text-secondary);">Combine gear from one or multiple stores in a single cart. Each store accepts your reservation voucher independently.</p>
        </div>

        <div class="rk-step-card">
            <div class="rk-step-number">03</div>
            <h3 style="font-size: var(--rk-font-size-md); margin-bottom: var(--rk-space-2);">3. Storefront Handover</h3>
            <p style="font-size: var(--rk-font-size-sm); color: var(--rk-text-secondary);">Visit the store counter with your digital pickup code. Inspect equipment condition together before taking it.</p>
        </div>

        <div class="rk-step-card">
            <div class="rk-step-number">04</div>
            <h3 style="font-size: var(--rk-font-size-md); margin-bottom: var(--rk-space-2);">4. Return & Review</h3>
            <p style="font-size: var(--rk-font-size-sm); color: var(--rk-text-secondary);">Return equipment by the scheduled time. Store signs off on return, deposit is reconciled, and you can leave a review.</p>
        </div>
    </div>
</section>

<!-- Featured Equipment Card Showcase (Dynamic from SQL Server) -->
<section class="rk-container" style="padding-bottom: var(--rk-space-12);" id="equipment-grid" aria-labelledby="featured-gear-title">
    <div class="rk-section-header">
        <div>
            <h2 id="featured-gear-title" class="rk-section-title">Popular Equipment Available for Rent</h2>
            <p class="rk-section-subtitle">Verified commercial-grade equipment ready for in-store pickup from approved partners.</p>
        </div>
        <a asp-controller="Catalog" asp-action="Index" class="rk-btn rk-btn-outline rk-btn-sm">View Full Catalog &rarr;</a>
    </div>

    @if (Model?.FeaturedListings != null && Model.FeaturedListings.Any())
    {
        <div class="rk-grid-4">
            @foreach (var item in Model.FeaturedListings)
            {
                <partial name="_EquipmentCard" model="item" />
            }
        </div>
    }
    else
    {
        <div class="rk-card" style="text-align: center; padding: var(--rk-space-12); background: #ffffff; border: 1px solid var(--rk-border-light); border-radius: var(--rk-radius-lg);">
            <div style="font-size: 48px; margin-bottom: var(--rk-space-3);">🏪</div>
            <h3 style="font-size: var(--rk-font-size-lg); font-weight: 700; color: var(--rk-navy-900); margin-bottom: var(--rk-space-2);">
                Marketplace Inventory Updating
            </h3>
            <p style="color: var(--rk-text-secondary); max-width: 480px; margin: 0 auto var(--rk-space-5) auto; line-height: 1.6;">
                Verified rental stores in your area are currently curating and uploading inspected equipment. Explore full categories or register your store to publish listings.
            </p>
            <div style="display: flex; gap: var(--rk-space-3); justify-content: center; flex-wrap: wrap;">
                <a asp-controller="Catalog" asp-action="Index" class="rk-btn rk-btn-teal">Explore Categories</a>
                <a asp-controller="Account" asp-action="RegisterBusiness" class="rk-btn rk-btn-secondary">Register as a Store</a>
            </div>
        </div>
    }
</section>

<!-- Trust & Security Pillars -->
<section style="background: var(--rk-neutral-50); border-top: 1px solid var(--rk-border-light); border-bottom: 1px solid var(--rk-border-light); padding: var(--rk-space-12) 0;">
    <div class="rk-container">
        <div class="rk-section-header" style="text-align: center; max-width: 650px; margin: 0 auto var(--rk-space-8) auto;">
            <h2 class="rk-section-title">Built for Trust & Transparency</h2>
            <p class="rk-section-subtitle">RentKart ensures a safe, accountable rental process with verified stores and documented handovers.</p>
        </div>

        <div class="rk-grid-3">
            <div class="rk-card" style="border: 1px solid var(--rk-border-light); background: #ffffff;">
                <div style="width: 48px; height: 48px; border-radius: 8px; background: rgba(13, 148, 136, 0.1); color: var(--rk-teal-700); display: flex; align-items: center; justify-content: center; margin-bottom: var(--rk-space-3);">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                </div>
                <h3 style="font-size: var(--rk-font-size-md); font-weight: 700; color: var(--rk-navy-900); margin-bottom: var(--rk-space-2);">Verified Business Stores</h3>
                <p style="font-size: var(--rk-font-size-sm); color: var(--rk-text-secondary); margin-bottom: 0;">Every partner business is verified with valid business registration and a physical storefront you can visit.</p>
            </div>

            <div class="rk-card" style="border: 1px solid var(--rk-border-light); background: #ffffff;">
                <div style="width: 48px; height: 48px; border-radius: 8px; background: rgba(15, 23, 42, 0.08); color: var(--rk-navy-900); display: flex; align-items: center; justify-content: center; margin-bottom: var(--rk-space-3);">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                </div>
                <h3 style="font-size: var(--rk-font-size-md); font-weight: 700; color: var(--rk-navy-900); margin-bottom: var(--rk-space-2);">Standard Rental Agreements</h3>
                <p style="font-size: var(--rk-font-size-sm); color: var(--rk-text-secondary); margin-bottom: 0;">Authoritative digital rental agreements and invoices generated for every booking group to protect both parties.</p>
            </div>

            <div class="rk-card" style="border: 1px solid var(--rk-border-light); background: #ffffff;">
                <div style="width: 48px; height: 48px; border-radius: 8px; background: rgba(13, 148, 136, 0.1); color: var(--rk-teal-700); display: flex; align-items: center; justify-content: center; margin-bottom: var(--rk-space-3);">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                </div>
                <h3 style="font-size: var(--rk-font-size-md); font-weight: 700; color: var(--rk-navy-900); margin-bottom: var(--rk-space-2);">Verified Renter Reviews</h3>
                <p style="font-size: var(--rk-font-size-sm); color: var(--rk-text-secondary); margin-bottom: 0;">Read authentic feedback from verified customers who completed real equipment rentals at each storefront.</p>
            </div>
        </div>
    </div>
</section>

<!-- Business Conversion Banner Section (High Contrast Deep Navy & Teal) -->
<section class="rk-business-cta" id="businesses" aria-labelledby="business-cta-title">
    <div class="rk-container">
        <div class="rk-business-cta-content">
            <span class="rk-business-cta-badge">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                    <polyline points="9 22 9 12 15 12 15 22"></polyline>
                </svg>
                For Equipment Rental Stores
            </span>
            <h2 id="business-cta-title" class="rk-business-cta-title">
                Do You Own a Rental Business in India?
            </h2>
            <p class="rk-business-cta-desc">
                Expand your customer base with a digital storefront on RentKart. Manage inventory availability, approve customer reservations, and generate formal rental agreements with zero technical complexity.
            </p>
            <div class="rk-business-cta-actions">
                <a asp-controller="Account" asp-action="RegisterBusiness" class="rk-btn-cta-primary">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                        <circle cx="8.5" cy="7" r="4"></circle>
                        <line x1="20" y1="8" x2="20" y2="14"></line>
                        <line x1="23" y1="11" x2="17" y2="11"></line>
                    </svg>
                    Register Your Business Storefront
                </a>
                <a asp-controller="Catalog" asp-action="Index" class="rk-btn-cta-secondary">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    Explore Marketplace
                </a>
            </div>
        </div>
    </div>
</section>
