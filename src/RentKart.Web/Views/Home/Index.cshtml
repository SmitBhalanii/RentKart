@model RentKart.Web.Models.HomeIndexViewModel
@{
    ViewData["Title"] = "Rent Anything You Need";
}

<!-- Hero Section -->
<section class="rk-hero" aria-label="Hero Introduction">
    <div class="rk-container">
        <div class="rk-hero-content">
            <div class="rk-hero-badge">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                <span>Local Multi-Vendor Marketplace &bull; Store Pickup & Return</span>
            </div>

            <h1 class="rk-hero-title">
                Rent Anything You Need — <span>From Local Businesses</span>
            </h1>

            <p class="rk-hero-subtitle">
                Access professional cameras, construction tools, audio systems, event setups, and outdoor gear without buying. Check live availability and pick up from verified neighborhood stores.
            </p>

            <!-- Live Search Form -->
            <form class="rk-hero-search" method="get" asp-controller="Catalog" asp-action="Index" role="search" aria-label="Search rental inventory">
                <div class="rk-hero-search-input">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--rk-color-teal-600)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    <input type="text" name="Search" placeholder="What equipment do you need? (e.g. Sony, Drill, Projector)" aria-label="Equipment search term" />
                </div>
                <div class="rk-hero-search-divider"></div>
                <div class="rk-hero-search-select">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--rk-color-slate-400)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                        <circle cx="12" cy="10" r="3"></circle>
                    </svg>
                    <select name="City" aria-label="Select rental store location">
                        <option value="">All Nearby Stores</option>
                        @if (Model?.AvailableCities != null)
                        {
                            foreach (var city in Model.AvailableCities)
                            {
                                <option value="@city">@city Stores</option>
                            }
                        }
                    </select>
                </div>
                <button type="submit" class="rk-btn rk-btn-teal rk-btn-lg" style="width: 100%; justify-content: center;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    <span>Search Gear</span>
                </button>
            </form>
        </div>
    </div>
</section>

<!-- Category Quick Filter Chips -->
<section class="rk-container" style="padding-top: var(--rk-space-6); padding-bottom: var(--rk-space-4);" id="categories" aria-label="Popular Categories">
    <div class="rk-category-chips">
        <a asp-controller="Catalog" asp-action="Index" class="rk-chip is-active">All Equipment</a>
        @if (Model?.Categories != null)
        {
            foreach (var cat in Model.Categories)
            {
                <a asp-controller="Catalog" asp-action="Index" asp-route-categorySlug="@cat.Slug" class="rk-chip">
                    @cat.Name (@cat.ActiveListingsCount)
                </a>
            }
        }
    </div>
</section>

<!-- How It Works Section -->
<section class="rk-container" style="padding-top: var(--rk-space-8); padding-bottom: var(--rk-space-12);" id="how-it-works" aria-labelledby="how-it-works-title">
    <div class="rk-section-header">
        <div>
            <h2 id="how-it-works-title" class="rk-section-title">How RentKart Works</h2>
            <p class="rk-section-subtitle">A modern local rental workflow connecting customers with verified physical stores.</p>
        </div>
        <span class="rk-badge rk-badge-teal">Simple 4-Step Process</span>
    </div>

    <div class="rk-grid-4">
        <div class="rk-step-card">
            <div class="rk-step-number">01</div>
            <h3 style="font-size: var(--rk-font-size-md); margin-bottom: var(--rk-space-2);">1. Discover & Check Dates</h3>
            <p style="font-size: var(--rk-font-size-sm); color: var(--rk-text-secondary);">Browse equipment listings from multiple nearby rental businesses and check real-time date availability.</p>
        </div>

        <div class="rk-step-card">
            <div class="rk-step-number">02</div>
            <h3 style="font-size: var(--rk-font-size-md); margin-bottom: var(--rk-space-2);">2. Request Reservation</h3>
            <p style="font-size: var(--rk-font-size-sm); color: var(--rk-text-secondary);">Add items from one or multiple stores to your rental cart and submit. Businesses confirm your booking voucher.</p>
        </div>

        <div class="rk-step-card">
            <div class="rk-step-number">03</div>
            <h3 style="font-size: var(--rk-font-size-md); margin-bottom: var(--rk-space-2);">3. Store Handover</h3>
            <p style="font-size: var(--rk-font-size-sm); color: var(--rk-text-secondary);">Visit the business store with your digital pickup code. Inspect equipment condition together before taking it.</p>
        </div>

        <div class="rk-step-card">
            <div class="rk-step-number">04</div>
            <h3 style="font-size: var(--rk-font-size-md); margin-bottom: var(--rk-space-2);">4. Return & Review</h3>
            <p style="font-size: var(--rk-font-size-sm); color: var(--rk-text-secondary);">Return equipment by the scheduled time. Business completes return sign-off and you can leave a verified review.</p>
        </div>
    </div>
</section>

<!-- Featured Equipment Card Showcase (Dynamic from SQL Server) -->
<section class="rk-container" style="padding-bottom: var(--rk-space-12);" id="equipment-grid" aria-labelledby="featured-gear-title">
    <div class="rk-section-header">
        <div>
            <h2 id="featured-gear-title" class="rk-section-title">Popular Equipment Available Today</h2>
            <p class="rk-section-subtitle">Verified equipment available for store pickup from approved local rental partners.</p>
        </div>
        <a asp-controller="Catalog" asp-action="Index" class="rk-btn rk-btn-outline rk-btn-sm">View Full Catalog &rarr;</a>
    </div>

    @if (Model?.FeaturedListings != null && Model.FeaturedListings.Any())
    {
        <div class="rk-grid-4">
            @foreach (var item in Model.FeaturedListings)
            {
                <article class="rk-card rk-equipment-card" aria-label="@item.Title">
                    <div class="rk-equipment-card-media" style="position: relative; height: 180px; background: var(--rk-neutral-100); overflow: hidden;">
                        @if (!string.IsNullOrEmpty(item.PrimaryImageUrl))
                        {
                            <img src="@item.PrimaryImageUrl" alt="@item.Title" style="width: 100%; height: 100%; object-fit: cover;" loading="lazy" />
                        }
                        else
                        {
                            <div style="display: flex; align-items: center; justify-content: center; height: 100%; color: var(--rk-text-muted);">
                                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                            </div>
                        }
                        <div class="rk-equipment-card-badge">
                            <span class="rk-badge rk-badge-confirmed"><span class="rk-badge-dot"></span>@item.Condition</span>
                        </div>
                    </div>
                    <div class="rk-equipment-card-content">
                        <div class="rk-equipment-card-store">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                            </svg>
                            <a asp-controller="Store" asp-action="Details" asp-route-id="@item.BusinessId" style="color: inherit; text-decoration: none;">
                                <span>@item.ShopName &bull; @item.City</span>
                            </a>
                        </div>
                        <h3 class="rk-equipment-card-title">
                            <a asp-controller="Catalog" asp-action="Details" asp-route-id="@item.Id" style="color: inherit; text-decoration: none;">
                                @item.Title
                            </a>
                        </h3>
                        <div class="rk-equipment-card-pricing">
                            <div>
                                <div class="rk-rate-amount">$@item.DailyRentalRate.ToString("F2") <span class="rk-rate-unit">/ day</span></div>
                                <div style="font-size: 0.6875rem; color: var(--rk-text-muted);">$@item.SecurityDeposit.ToString("F2") deposit</div>
                            </div>
                            <a asp-controller="Catalog" asp-action="Details" asp-route-id="@item.Id" class="rk-btn rk-btn-teal rk-btn-sm" aria-label="View details for @item.Title">
                                View Details
                            </a>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
    else
    {
        <div class="rk-card" style="text-align: center; padding: var(--rk-space-6);">
            <p style="color: var(--rk-text-muted); margin-bottom: 0;">No active equipment listings found in the catalog at this time.</p>
        </div>
    }
</section>

<!-- Global Component Preview & Design System Section -->
<section class="rk-container" style="padding-top: var(--rk-space-8); padding-bottom: var(--rk-space-16);" id="component-preview" aria-labelledby="ui-spec-title">
    <div style="border-top: 2px dashed var(--rk-border-subtle); padding-top: var(--rk-space-10);">
        <div class="rk-section-header">
            <div>
                <span class="rk-badge rk-badge-teal" style="margin-bottom: var(--rk-space-2);">Phase 2 Visual Verification</span>
                <h2 id="ui-spec-title" class="rk-section-title">RentKart Design System & Component Library</h2>
                <p class="rk-section-subtitle">Shared UI building blocks adhering to accessibility, contrast, and layout constraints.</p>
            </div>
        </div>

        <div class="rk-grid-2">
            <!-- Buttons & Action Hierarchy -->
            <div class="rk-card">
                <div class="rk-card-header">
                    <h3 style="font-size: var(--rk-font-size-md);">Buttons & Hierarchy</h3>
                    <span class="rk-badge rk-badge-neutral">Tokens</span>
                </div>
                <div class="rk-card-body" style="display: flex; flex-direction: column; gap: var(--rk-space-4);">
                    <div style="display: flex; flex-wrap: wrap; gap: var(--rk-space-2); align-items: center;">
                        <button type="button" class="rk-btn rk-btn-primary">Primary Navy</button>
                        <button type="button" class="rk-btn rk-btn-teal">Accent Teal</button>
                        <button type="button" class="rk-btn rk-btn-secondary">Secondary Slate</button>
                        <button type="button" class="rk-btn rk-btn-outline">Outline</button>
                        <button type="button" class="rk-btn rk-btn-danger">Danger Action</button>
                    </div>
                    <div style="display: flex; flex-wrap: wrap; gap: var(--rk-space-2); align-items: center;">
                        <button type="button" class="rk-btn rk-btn-teal rk-btn-sm">Small Button</button>
                        <button type="button" class="rk-btn rk-btn-teal">Regular Size</button>
                        <button type="button" class="rk-btn rk-btn-teal rk-btn-lg">Large Size</button>
                        <button type="button" class="rk-btn rk-btn-primary" disabled>Disabled State</button>
                    </div>
                </div>
            </div>

            <!-- Status Badges & Indicators -->
            <div class="rk-card">
                <div class="rk-card-header">
                    <h3 style="font-size: var(--rk-font-size-md);">Rental Status Badges</h3>
                    <span class="rk-badge rk-badge-neutral">State Machine</span>
                </div>
                <div class="rk-card-body" style="display: flex; flex-wrap: wrap; gap: var(--rk-space-3); align-items: center;">
                    <span class="rk-badge rk-badge-pending"><span class="rk-badge-dot"></span>Pending Approval</span>
                    <span class="rk-badge rk-badge-confirmed"><span class="rk-badge-dot"></span>Confirmed</span>
                    <span class="rk-badge rk-badge-active"><span class="rk-badge-dot"></span>Handed Over / Active</span>
                    <span class="rk-badge rk-badge-completed"><span class="rk-badge-dot"></span>Completed</span>
                    <span class="rk-badge rk-badge-danger"><span class="rk-badge-dot"></span>Rejected / Cancelled</span>
                    <span class="rk-badge rk-badge-neutral"><span class="rk-badge-dot"></span>Under Maintenance</span>
                </div>
            </div>
        </div>

        <!-- Form Controls Demonstration -->
        <div class="rk-card" style="margin-top: var(--rk-space-6);">
            <div class="rk-card-header">
                <h3 style="font-size: var(--rk-font-size-md);">Accessible Form Controls</h3>
                <span class="rk-badge rk-badge-neutral">Focus Ring & Labels</span>
            </div>
            <div class="rk-card-body">
                <div class="rk-grid-3">
                    <div class="rk-form-group">
                        <label for="sampleInput" class="rk-form-label">Full Name</label>
                        <input id="sampleInput" type="text" class="rk-form-control" placeholder="e.g. Smit Bhalani" />
                        <span class="rk-form-hint">Must match your government-issued ID for store pickup.</span>
                    </div>

                    <div class="rk-form-group">
                        <label for="sampleSelect" class="rk-form-label">Storefront Location</label>
                        <select id="sampleSelect" class="rk-form-select">
                            <option>Downtown Storefront (10 AM - 7 PM)</option>
                            <option>West End Depot (9 AM - 6 PM)</option>
                            <option>Northside Hub (11 AM - 8 PM)</option>
                        </select>
                        <span class="rk-form-hint">Physical equipment inspection location.</span>
                    </div>

                    <div class="rk-form-group">
                        <label for="sampleError" class="rk-form-label">Rental Daily Rate ($)</label>
                        <div class="rk-input-group">
                            <span class="rk-input-addon-left" aria-hidden="true">$</span>
                            <input id="sampleError" type="number" class="rk-form-control has-addon-left" value="45.00" aria-describedby="sampleErrorMsg" />
                        </div>
                        <span id="sampleErrorMsg" class="rk-form-error">Standard rate validated on server.</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Shared Table Component -->
        <div style="margin-top: var(--rk-space-6);">
            <h3 style="font-size: var(--rk-font-size-lg); margin-bottom: var(--rk-space-3);">Shared Table Component (.rk-table)</h3>
            <div class="rk-table-container">
                <table class="rk-table" aria-label="Sample booking orders preview">
                    <thead>
                        <tr>
                            <th>Group Order #</th>
                            <th>Rental Business</th>
                            <th>Equipment Items</th>
                            <th>Scheduled Dates</th>
                            <th>Security Deposit</th>
                            <th>Subgroup Status</th>
                            <th style="text-align: right;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><strong>#RK-10082-A</strong></td>
                            <td>Apex Media Rentals</td>
                            <td>Sony Alpha 7 IV Kit &bull; 1 Unit</td>
                            <td>Oct 20, 2026 &ndash; Oct 24, 2026</td>
                            <td>$150.00</td>
                            <td><span class="rk-badge rk-badge-confirmed"><span class="rk-badge-dot"></span>Confirmed</span></td>
                            <td style="text-align: right;">
                                <button type="button" class="rk-btn rk-btn-secondary rk-btn-sm">View Voucher</button>
                            </td>
                        </tr>
                        <tr>
                            <td><strong>#RK-10082-B</strong></td>
                            <td>Metro Tool Supply</td>
                            <td>DeWalt 20V Combo &bull; 1 Unit</td>
                            <td>Oct 20, 2026 &ndash; Oct 22, 2026</td>
                            <td>$80.00</td>
                            <td><span class="rk-badge rk-badge-pending"><span class="rk-badge-dot"></span>Awaiting Pickup</span></td>
                            <td style="text-align: right;">
                                <button type="button" class="rk-btn rk-btn-teal rk-btn-sm">Pickup Code</button>
                            </td>
                        </tr>
                        <tr>
                            <td><strong>#RK-10079-A</strong></td>
                            <td>Vision Event Hub</td>
                            <td>Epson Pro Cinema 4K &bull; 2 Units</td>
                            <td>Oct 10, 2026 &ndash; Oct 12, 2026</td>
                            <td>$400.00</td>
                            <td><span class="rk-badge rk-badge-completed"><span class="rk-badge-dot"></span>Completed</span></td>
                            <td style="text-align: right;">
                                <button type="button" class="rk-btn rk-btn-outline rk-btn-sm">Write Review</button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Shared Alerts & Feedback States -->
        <div style="margin-top: var(--rk-space-6);">
            <h3 style="font-size: var(--rk-font-size-lg); margin-bottom: var(--rk-space-3);">Alert & Notification Styles</h3>
            <div class="rk-alert rk-alert-success">
                <svg class="rk-alert-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                    <polyline points="22 4 12 14.01 9 11.01"></polyline>
                </svg>
                <div class="rk-alert-content">
                    <strong>Booking Group Accepted:</strong> Apex Media Rentals accepted your reservation for Oct 20. Your digital pickup voucher is ready.
                </div>
            </div>

            <div class="rk-alert rk-alert-warning">
                <svg class="rk-alert-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path>
                    <line x1="12" y1="9" x2="12" y2="13"></line>
                    <line x1="12" y1="17" x2="12.01" y2="17"></line>
                </svg>
                <div class="rk-alert-content">
                    <strong>Pickup Reminder:</strong> Please bring government photo ID matching your profile name to the storefront.
                </div>
            </div>

            <div class="rk-alert rk-alert-danger">
                <svg class="rk-alert-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                <div class="rk-alert-content">
                    <strong>Reservation Conflict:</strong> The selected dates are in maintenance downtime. Please pick alternative dates.
                </div>
            </div>
        </div>

        <!-- Empty & Loading States Demonstration -->
        <div class="rk-grid-2" style="margin-top: var(--rk-space-6);">
            <div>
                <h3 style="font-size: var(--rk-font-size-lg); margin-bottom: var(--rk-space-3);">Empty State (.rk-empty-state)</h3>
                <div class="rk-empty-state">
                    <div class="rk-empty-state-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                    </div>
                    <div class="rk-empty-state-title">No Equipment Found</div>
                    <p class="rk-empty-state-text">We couldn't find any listings matching your search filters in this district. Try broadening your dates or categories.</p>
                    <button type="button" class="rk-btn rk-btn-secondary rk-btn-sm">Reset Search Filters</button>
                </div>
            </div>

            <div>
                <h3 style="font-size: var(--rk-font-size-lg); margin-bottom: var(--rk-space-3);">Loading States (.rk-skeleton & .rk-spinner)</h3>
                <div class="rk-card" style="padding: var(--rk-space-6); display: flex; flex-direction: column; gap: var(--rk-space-4);">
                    <div style="display: flex; align-items: center; gap: var(--rk-space-3);">
                        <div class="rk-spinner" aria-label="Loading indicator"></div>
                        <span style="font-size: var(--rk-font-size-sm); color: var(--rk-text-muted);">Fetching store availability calendar...</span>
                    </div>
                    <div class="rk-skeleton" style="height: 18px; width: 60%;"></div>
                    <div class="rk-skeleton" style="height: 14px; width: 90%;"></div>
                    <div class="rk-skeleton" style="height: 14px; width: 75%;"></div>
                    <div class="rk-skeleton" style="height: 38px; width: 40%; margin-top: var(--rk-space-2);"></div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Business Conversion Banner Section -->
<section style="background-color: var(--rk-color-navy-900); color: var(--rk-color-white); padding: var(--rk-space-12) 0;" id="businesses" aria-labelledby="business-cta-title">
    <div class="rk-container">
        <div style="display: flex; flex-direction: column; gap: var(--rk-space-6); align-items: center; text-align: center; max-width: 680px; margin: 0 auto;">
            <span class="rk-badge rk-badge-teal">For Equipment Rental Stores</span>
            <h2 id="business-cta-title" style="color: var(--rk-color-white); font-size: var(--rk-font-size-3xl);">Do You Own a Rental Business?</h2>
            <p style="color: var(--rk-color-slate-300); font-size: var(--rk-font-size-md);">
                Expand your customer base with a digital storefront on RentKart. Manage inventory, approve reservations, and streamline store handovers with zero tech hassle.
            </p>
            <div style="display: flex; gap: var(--rk-space-3); flex-wrap: wrap; justify-content: center;">
                <a href="#how-it-works" class="rk-btn rk-btn-teal rk-btn-lg">Register Your Business Storefront</a>
                <a href="#how-it-works" class="rk-btn rk-btn-outline rk-btn-lg" style="color: var(--rk-color-white); border-color: rgba(255,255,255,0.3);">Learn How It Works</a>
            </div>
        </div>
    </div>
</section>
