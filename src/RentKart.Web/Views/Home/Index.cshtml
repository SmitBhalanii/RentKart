<!-- Global Component Preview & Design System Section -->
<section class="rk-container" style="padding-top: var(--rk-space-8); padding-bottom: var(--rk-space-16);" id="component-preview" aria-labelledby="ui-spec-title">
    <div style="border-top: 2px dashed var(--rk-border-subtle); padding-top: var(--rk-space-10);">
        <div class="rk-section-header">
            <div>
                <span class="rk-badge rk-badge-teal" style="margin-bottom: var(--rk-space-2);">Phase 2 Visual Verification</span>
                <h2 id="ui-spec-title" class="rk-section-title">RentKart Design System & Component Library</h2>
                <p class="rk-section-subtitle">Shared UI building blocks adhering to accessibility, contrast, and layout constraints.</p>
            </div>
        </div>

        <div class="rk-grid-2">
            <!-- Buttons & Action Hierarchy -->
            <div class="rk-card">
                <div class="rk-card-header">
                    <h3 style="font-size: var(--rk-font-size-md);">Buttons & Hierarchy</h3>
                    <span class="rk-badge rk-badge-neutral">Tokens</span>
                </div>
                <div class="rk-card-body" style="display: flex; flex-direction: column; gap: var(--rk-space-4);">
                    <div style="display: flex; flex-wrap: wrap; gap: var(--rk-space-2); align-items: center;">
                        <button type="button" class="rk-btn rk-btn-primary">Primary Navy</button>
                        <button type="button" class="rk-btn rk-btn-teal">Accent Teal</button>
                        <button type="button" class="rk-btn rk-btn-secondary">Secondary Slate</button>
                        <button type="button" class="rk-btn rk-btn-outline">Outline</button>
                        <button type="button" class="rk-btn rk-btn-danger">Danger Action</button>
                    </div>
                    <div style="display: flex; flex-wrap: wrap; gap: var(--rk-space-2); align-items: center;">
                        <button type="button" class="rk-btn rk-btn-teal rk-btn-sm">Small Button</button>
                        <button type="button" class="rk-btn rk-btn-teal">Regular Size</button>
                        <button type="button" class="rk-btn rk-btn-teal rk-btn-lg">Large Size</button>
                        <button type="button" class="rk-btn rk-btn-primary" disabled>Disabled State</button>
                    </div>
                </div>
            </div>

            <!-- Status Badges & Indicators -->
            <div class="rk-card">
                <div class="rk-card-header">
                    <h3 style="font-size: var(--rk-font-size-md);">Rental Status Badges</h3>
                    <span class="rk-badge rk-badge-neutral">State Machine</span>
                </div>
                <div class="rk-card-body" style="display: flex; flex-wrap: wrap; gap: var(--rk-space-3); align-items: center;">
                    <span class="rk-badge rk-badge-pending"><span class="rk-badge-dot"></span>Pending Approval</span>
                    <span class="rk-badge rk-badge-confirmed"><span class="rk-badge-dot"></span>Confirmed</span>
                    <span class="rk-badge rk-badge-active"><span class="rk-badge-dot"></span>Handed Over / Active</span>
                    <span class="rk-badge rk-badge-completed"><span class="rk-badge-dot"></span>Completed</span>
                    <span class="rk-badge rk-badge-danger"><span class="rk-badge-dot"></span>Rejected / Cancelled</span>
                    <span class="rk-badge rk-badge-neutral"><span class="rk-badge-dot"></span>Under Maintenance</span>
                </div>
            </div>
        </div>

        <!-- Form Controls Demonstration -->
        <div class="rk-card" style="margin-top: var(--rk-space-6);">
            <div class="rk-card-header">
                <h3 style="font-size: var(--rk-font-size-md);">Accessible Form Controls</h3>
                <span class="rk-badge rk-badge-neutral">Focus Ring & Labels</span>
            </div>
            <div class="rk-card-body">
                <div class="rk-grid-3">
                    <div class="rk-form-group">
                        <label for="sampleInput" class="rk-form-label">Full Name</label>
                        <input id="sampleInput" type="text" class="rk-form-control" placeholder="e.g. Smit Bhalani" />
                        <span class="rk-form-hint">Must match your government-issued ID for store pickup.</span>
                    </div>

                    <div class="rk-form-group">
                        <label for="sampleSelect" class="rk-form-label">Storefront Location</label>
                        <select id="sampleSelect" class="rk-form-select">
                            <option>Downtown Storefront (10 AM - 7 PM)</option>
                            <option>West End Depot (9 AM - 6 PM)</option>
                            <option>Northside Hub (11 AM - 8 PM)</option>
                        </select>
                        <span class="rk-form-hint">Physical equipment inspection location.</span>
                    </div>

                    <div class="rk-form-group">
                        <label for="sampleError" class="rk-form-label">Rental Daily Rate ($)</label>
                        <div class="rk-input-group">
                            <span class="rk-input-addon-left" aria-hidden="true">$</span>
                            <input id="sampleError" type="number" class="rk-form-control has-addon-left" value="45.00" aria-describedby="sampleErrorMsg" />
                        </div>
                        <span id="sampleErrorMsg" class="rk-form-error">Standard rate validated on server.</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Shared Table Component -->
        <div style="margin-top: var(--rk-space-6);">
