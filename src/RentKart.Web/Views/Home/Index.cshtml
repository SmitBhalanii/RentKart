@{
    ViewData["Title"] = "Rent Anything You Need";
}

<!-- Hero Section -->
<section class="rk-hero" aria-label="Hero Introduction">
    <div class="rk-container">
        <div class="rk-hero-content">
            <div class="rk-hero-badge">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                <span>Local Multi-Vendor Marketplace &bull; Store Pickup & Return</span>
            </div>

            <h1 class="rk-hero-title">
                Rent Anything You Need — <span>From Local Businesses</span>
            </h1>

            <p class="rk-hero-subtitle">
                Access professional cameras, construction tools, audio systems, event setups, and outdoor gear without buying. Check live availability and pick up from verified neighborhood stores.
            </p>

            <!-- Search Shell (Presentation Prototype) -->
            <form class="rk-hero-search" method="get" action="#equipment-grid" onsubmit="event.preventDefault();" role="search" aria-label="Search rental inventory">
                <div class="rk-hero-search-input">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--rk-color-teal-600)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    <input type="text" placeholder="What equipment do you need? (e.g. Sony A7, Drill, Projector)" aria-label="Equipment search term" />
                </div>
                <div class="rk-hero-search-divider"></div>
                <div class="rk-hero-search-select">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--rk-color-slate-400)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                        <circle cx="12" cy="10" r="3"></circle>
                    </svg>
                    <select aria-label="Select rental location">
                        <option value="">All Nearby Stores</option>
                        <option value="downtown">Downtown District</option>
                        <option value="northside">Northside Business Hub</option>
                        <option value="westend">West End Equipment Depot</option>
                    </select>
                </div>
                <button type="submit" class="rk-btn rk-btn-teal rk-btn-lg" style="width: 100%; justify-content: center;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    <span>Search Gear</span>
                </button>
            </form>
        </div>
    </div>
</section>

<!-- Category Quick Filter Chips -->
<section class="rk-container" style="padding-top: var(--rk-space-6); padding-bottom: var(--rk-space-4);" id="categories" aria-label="Popular Categories">
    <div class="rk-category-chips">
        <a href="#equipment-grid" class="rk-chip is-active">All Equipment</a>
        <a href="#equipment-grid" class="rk-chip">Cameras & Optics</a>
        <a href="#equipment-grid" class="rk-chip">Heavy Power Tools</a>
        <a href="#equipment-grid" class="rk-chip">Audio & Sound Systems</a>
        <a href="#equipment-grid" class="rk-chip">Display & Projectors</a>
        <a href="#equipment-grid" class="rk-chip">Ladders & Scaffolding</a>
        <a href="#equipment-grid" class="rk-chip">Event Tents & Furniture</a>
        <a href="#equipment-grid" class="rk-chip">Camping & Outdoor Gear</a>
    </div>
</section>

<!-- How It Works Section -->
<section class="rk-container" style="padding-top: var(--rk-space-8); padding-bottom: var(--rk-space-12);" id="how-it-works" aria-labelledby="how-it-works-title">
    <div class="rk-section-header">
        <div>
            <h2 id="how-it-works-title" class="rk-section-title">How RentKart Works</h2>
            <p class="rk-section-subtitle">A modern local rental workflow connecting customers with verified physical stores.</p>
        </div>
        <span class="rk-badge rk-badge-teal">Simple 4-Step Process</span>
    </div>

    <div class="rk-grid-4">
        <div class="rk-step-card">
            <div class="rk-step-number">01</div>
            <h3 style="font-size: var(--rk-font-size-md); margin-bottom: var(--rk-space-2);">1. Discover & Check Dates</h3>
            <p style="font-size: var(--rk-font-size-sm); color: var(--rk-text-secondary);">Browse equipment listings from multiple nearby rental businesses and check real-time date availability.</p>
        </div>

        <div class="rk-step-card">
            <div class="rk-step-number">02</div>
            <h3 style="font-size: var(--rk-font-size-md); margin-bottom: var(--rk-space-2);">2. Request Reservation</h3>
            <p style="font-size: var(--rk-font-size-sm); color: var(--rk-text-secondary);">Add items from one or multiple stores to your rental cart and submit. Businesses confirm your booking voucher.</p>
        </div>

        <div class="rk-step-card">
            <div class="rk-step-number">03</div>
            <h3 style="font-size: var(--rk-font-size-md); margin-bottom: var(--rk-space-2);">3. Store Handover</h3>
            <p style="font-size: var(--rk-font-size-sm); color: var(--rk-text-secondary);">Visit the business store with your digital pickup code. Inspect equipment condition together before taking it.</p>
        </div>

        <div class="rk-step-card">
            <div class="rk-step-number">04</div>
            <h3 style="font-size: var(--rk-font-size-md); margin-bottom: var(--rk-space-2);">4. Return & Review</h3>
            <p style="font-size: var(--rk-font-size-sm); color: var(--rk-text-secondary);">Return equipment by the scheduled time. Business completes return sign-off and you can leave a verified review.</p>
        </div>
    </div>
</section>

